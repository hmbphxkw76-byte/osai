# ===============================================================================
# 前沿漏洞 Scaffold 模板 — 新建漏洞时复制此文件
# ===============================================================================
# 用法:
#   1. cp -r vulns/_scaffold vulns/2026H2-<漏洞名>
#   2. 按下方注释编辑 manifest.yaml
#   3. 编辑 payloads.yaml
#   4. 将 status 改为 "active" → 自动加入攻击管道
# ===============================================================================

# ── 必填字段 ──
id: "FRONTIER-2026-XXX"              # 唯一标识，格式: FRONTIER-{年份}-{序号}
name: "新漏洞名称"                     # 简短描述性名称
status: "experimental"               # experimental | active | deprecated | retired
severity: "medium"                   # critical | high | medium | low | info
confidence: 0.5                      # 估算成功率 (0.0-1.0)

# ── 推荐填写 ──
discovery_date: "2026-07-01"         # 发现日期
discovered_by: "填入发现方"           # 发现方（团队/研究人员）
cve: ""                              # CVE 编号（如有）
paper: ""                            # 论文链接（如有）

# ── 分类筛选 ──
tags:                                # 标签（用于搜索和筛选）
  - example-tag

# ── 攻击配置 ──
attack_strategy: "new_vuln_strategy" # 策略名称（在 AttackStrategy 中作为 frontier_xxx 使用）
converter: ""                        # 复用已有转换器（如 ContextualPrimingConverter），空则直发
requires_advanced_pipeline: false    # 是否需特殊执行器（true 则走高级管道）

# ── 详细描述 ──
description: >
  在此填写完整的漏洞描述，包括:
  - 攻击原理
  - 影响的模型类型
  - 已知受影响版本

# ── 已知缓解措施 ──
known_mitigations:
  - "示例缓解措施 1"
  - "示例缓解措施 2"

# ── 攻击示例（用于文档/报告）──
examples:
  - objective: "示例攻击目标 1"
    variant: "basic"
    expected_behavior: "预期行为描述"
  - objective: "示例攻击目标 2"
    variant: "advanced"
    expected_behavior: "预期行为描述"
