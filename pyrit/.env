##############################################################################
#                    OffSec AI-300 多平台API配置文件
##############################################################################
# 📌 攻击者平台选择（修改下方 PLATFORM_SELECTOR 的值）
#    若攻击的是自定义 API（--target-url），可留空，只需配置评分器。
#
# 📌 评分器独立配置（可选，解决低能力模型无法胜任 Judge 的问题）：
#    方式 1 — 同平台不同模型：在 [PLATFORM] 节中取消注释 SCORER_MODEL=行
#    方式 2 — 不同平台：设置 SCORER_PLATFORM_SELECTOR=另一平台名
#    方式 3 — 攻击自定义 API：只设 SCORER_PLATFORM_SELECTOR，PLATFORM_SELECTOR 留空
#    ⚠️ 取消注释 SCORER_MODEL 时，请删除行尾的中文说明文字
#
# 支持平台列表:
#   国内平台: ZHIPU, QWEN, BAIDU, DEEPSEEK
#   国外主流: OPENAI, ANTHROPIC, AZURE_OPENAI, AWS_BEDROCK, GOOGLE_GEMINI
#   开源本地: OLLAMA, HUGGINGFACE
#   欧洲平台: COHERE, MISTRAL, VOYAGE, PERPLEXITY
#   Meta平台: META_LLAMA
##############################################################################

PLATFORM_SELECTOR=OLLAMA

# 评分器独立平台选择（可选，不设则复用攻击者配置）
# SCORER_PLATFORM_SELECTOR=ZHIPU


##############################################################################
# ==================== 国外主流平台 ====================
##############################################################################

# ------------------------------
# OpenAI
# 官网: https://platform.openai.com
# ------------------------------
[OPENAI]
OPENAI_CHAT_ENDPOINT=https://api.openai.com/v1
CHAT_MODEL=gpt-4o
# SCORER_MODEL=gpt-4o            ← 取消注释为评分器使用独立模型（可同可异）
OPENAI_CHAT_KEY=your-openai-api-key-here
# 可选模型: gpt-4o-mini, gpt-4-turbo, gpt-4, gpt-3.5-turbo

# ------------------------------
# Anthropic Claude
# 官网: https://console.anthropic.com
# ------------------------------
[ANTHROPIC]
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CHAT_MODEL=claude-3-sonnet-20240229
# SCORER_MODEL=claude-3-opus-20240229  ← 取消注释为评分器使用独立模型
# 可选模型: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307

# ------------------------------
# Azure OpenAI
# 官网: https://azure.microsoft.com/zh-cn/products/ai-services/openai-service
# ------------------------------
[AZURE_OPENAI]
OPENAI_CHAT_ENDPOINT=https://your-resource.openai.azure.com/openai/deployments/gpt-4o/chat/completions?api-version=2024-12-01-preview
CHAT_MODEL=gpt-4o
# SCORER_MODEL=gpt-4o            ← 取消注释为评分器使用独立模型
OPENAI_CHAT_KEY=your-azure-api-key-here

# ------------------------------
# AWS Bedrock
# 官网: https://aws.amazon.com/bedrock
# 需要安装 boto3 库并配置 AWS 凭证
# ------------------------------
[AWS_BEDROCK]
BEDROCK_REGION=us-east-1
BEDROCK_ACCESS_KEY=your-aws-access-key-here
BEDROCK_SECRET_KEY=your-aws-secret-key-here
CHAT_MODEL=anthropic.claude-3-sonnet-20240229-v1:0
# SCORER_MODEL=anthropic.claude-3-opus  ← 取消注释为评分器使用独立模型
# 可选模型: anthropic.claude-3-opus, amazon.titan-text-lite-v1, meta.llama3-70b-chat

# ------------------------------
# Google Gemini
# 官网: https://ai.google.dev
# 需要安装 google-generativeai 库
# ------------------------------
[GOOGLE_GEMINI]
GEMINI_API_KEY=your-gemini-api-key-here
CHAT_MODEL=gemini-1.5-flash
# SCORER_MODEL=gemini-1.5-pro       ← 取消注释为评分器使用独立模型
# 可选模型: gemini-1.5-pro, gemini-2.0-flash, gemini-2.0-pro

# ------------------------------
# Meta Llama Cloud
# 官网: https://llama.meta.com
# ------------------------------
[META_LLAMA]
OPENAI_CHAT_ENDPOINT=https://api.llama.meta.com/v1
CHAT_MODEL=llama-3.3-70b
# SCORER_MODEL=llama-3.3-400b        ← 取消注释为评分器使用独立模型
OPENAI_CHAT_KEY=your-meta-api-key-here
# 可选模型: llama-3.3-8b, llama-3.3-70b, llama-3.3-400b

##############################################################################
# ==================== 开源本地平台 ====================
##############################################################################

# ------------------------------
# Ollama (本地部署)
# 官网: https://ollama.com
# 启动命令: ollama serve
# ------------------------------
[OLLAMA]
OPENAI_CHAT_ENDPOINT=http://localhost:11434/v1
CHAT_MODEL=tinyllama
SCORER_MODEL=qwen3:1.7b
OPENAI_CHAT_KEY=your-ollama-api-key-here
# 可选模型: qwen3:0.6b, qwen3:1.7b, qwen3:4b, gemma2:2b, phi3:3.8b, mistral:7b, llama3.3:70b, tinyllama,MiniCPM5-1B

# ------------------------------
# Hugging Face Inference Endpoints
# 官网: https://huggingface.co/inference-endpoints
# ------------------------------
[HUGGINGFACE]
OPENAI_CHAT_ENDPOINT=https://api-inference.huggingface.co/v1
CHAT_MODEL=HuggingFaceH4/zephyr-7b-beta
# SCORER_MODEL=mistralai/Mistral-7B-Instruct-v0.3  ← 取消注释为评分器使用独立模型
OPENAI_CHAT_KEY=your-huggingface-api-key-here
# 可选模型: meta-llama/Llama-2-7b-chat-hf, mistralai/Mistral-7B-Instruct-v0.3

##############################################################################
# ==================== 国内平台 ====================
##############################################################################

# ------------------------------
# 智谱 AI (Zhipu AI)
# 官网: https://open.bigmodel.cn
# ------------------------------
[ZHIPU]
OPENAI_CHAT_ENDPOINT=https://open.bigmodel.cn/api/paas/v4
CHAT_MODEL=GLM-4.7-Flash
# SCORER_MODEL=GLM-5.2          ← 取消注释为评分器使用更强模型
OPENAI_CHAT_KEY=63f2e11b222a4af5bde7357ec58fd70e.8oogCzwisIih1on4
# 可选模型: GLM-4.7-Flash, GLM-4.7-FlashX, GLM-5.2  

# ------------------------------
# 阿里千问 (Aliyun Qwen)
# 官网: https://dashscope.console.aliyun.com
# ------------------------------
[QWEN]
OPENAI_CHAT_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-turbo
# SCORER_MODEL=qwen-max              ← 取消注释为评分器使用独立模型
OPENAI_CHAT_KEY=your-qwen-api-key-here
# 可选模型: qwen-turbo, qwen-plus, qwen-max, qwen2-7b, qwen2-72b

# ------------------------------
# 百度文心一言 (Baidu ERNIE)
# 官网: https://cloud.baidu.com/product/wenxinworkshop
# ------------------------------
[BAIDU]
OPENAI_CHAT_ENDPOINT=https://aip.baidubce.com/rpc/2.0/ai_custom/v1/wenxinworkshop/chat/completions
CHAT_MODEL=ernie-4.0-turbo
# SCORER_MODEL=ernie-4.0-turbo       ← 取消注释为评分器使用独立模型
OPENAI_CHAT_KEY=your-baidu-api-key-here
# 需要额外配置 BAIDU_SECRET_KEY
BAIDU_SECRET_KEY=your-baidu-secret-key-here
# 可选模型: ernie-4.0-turbo, ernie-3.5-turbo, ernie-3.0, ernie-longtext

# ------------------------------
# DeepSeek (深度求索)
# 官网: https://platform.deepseek.com
# ------------------------------
[DEEPSEEK]
OPENAI_CHAT_ENDPOINT=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat
# SCORER_MODEL=deepseek-r1-chat      ← 取消注释为评分器使用独立模型
OPENAI_CHAT_KEY=your-deepseek-api-key-here
# 可选模型: deepseek-chat, deepseek-r1-chat, deepseek-r1.5-chat


##############################################################################
# ==================== 欧洲平台 ====================
##############################################################################

# ------------------------------
# Cohere (加拿大/欧洲)
# 官网: https://cohere.com
# ------------------------------
[COHERE]
COHERE_API_KEY=your-cohere-api-key-here
CHAT_MODEL=command-r-plus
# SCORER_MODEL=command-r-plus        ← 取消注释为评分器使用独立模型
# 可选模型: command-r-plus, command-r, command, command-light

# ------------------------------
# Mistral AI (法国)
# 官网: https://mistral.ai
# ------------------------------
[MISTRAL]
OPENAI_CHAT_ENDPOINT=https://api.mistral.ai/v1
CHAT_MODEL=mistral-large-latest
# SCORER_MODEL=mistral-large-latest  ← 取消注释为评分器使用独立模型
OPENAI_CHAT_KEY=your-mistral-api-key-here
# 可选模型: mistral-large-latest, mistral-medium, mistral-small, open-mistral-7b

# ------------------------------
# Voyage AI (欧洲/美国)
# 官网: https://www.voyageai.com
# ------------------------------
[VOYAGE]
VOYAGE_API_KEY=your-voyage-api-key-here
CHAT_MODEL=voyage-large-2
# SCORER_MODEL=voyage-large-2        ← 取消注释为评分器使用独立模型
# 可选模型: voyage-large-2, voyage-2

# ------------------------------
# Perplexity AI (美国/全球)
# 官网: https://www.perplexity.ai
# ------------------------------
[PERPLEXITY]
OPENAI_CHAT_ENDPOINT=https://api.perplexity.ai
CHAT_MODEL=llama-3-sonar-large-32k-chat
# SCORER_MODEL=llama-3-sonar-large-32k-chat  ← 取消注释为评分器使用独立模型
OPENAI_CHAT_KEY=your-perplexity-api-key-here
# 可选模型: llama-3-sonar-large-32k-chat, llama-3-sonar-small-32k-chat


##############################################################################
# ==================== 通用配置 ====================
# 以下配置适用于所有平台
##############################################################################

# 请求超时时间（秒）
REQUEST_TIMEOUT=60

# 是否启用调试模式（输出详细日志）
DEBUG_MODE=false

# 默认模型参数
TEMPERATURE=0.7

MAX_TOKENS=4096
