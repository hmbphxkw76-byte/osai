##############################################################################
#  渗透测试平台配置 — 通用参数
##############################################################################
#  PLATFORM_SELECTOR  → 攻击平台模式（引用 configs/platforms.env 中的预设节）
#    可选: ATTACK_with_SCORE | Only_SCORE | ONLY_ATTACK
#    不设 → 回退 DEFAULT 平铺变量 / 使用 --target-url 自定义目标
#  SCORE_SELECTOR    → 🆕 独立评分平台选择器（可选，覆盖 PLATFORM_SELECTOR 的评分配置）
#    可选: SCORE | Only_SCORE | 任意含 SCORE_* 键的节名
#    不设 → 评分和攻击共用 PLATFORM_SELECTOR 节（向后兼容）
#  TARGET_PRESET      → 红队攻击预设（引用 configs/targets.env）
#    可选: API_KEY | OPENAI | VISION | JWT_ONLY | DUAL_AUTH 等
#  RECON_PRESET       → 侦查阶段预设（引用 configs/recons.env）
#    可选: MODELS_RECON | HEALTH_RECON | GET_RECON
#
#  🆕 典型场景配置:
#    测试已知模型 API:   PLATFORM_SELECTOR=ATTACK_with_SCORE  (默认)
#    自定义 AI 应用侦察:  PLATFORM_SELECTOR= + SCORE_SELECTOR=SCORE
##############################################################################

PLATFORM_SELECTOR=ATTACK_with_SCORE

# 🆕 独立评分选择器 — 留空则评分与攻击共用 PLATFORM_SELECTOR 节
# 自定义 AI 应用侦察时建议取消下面注释:
# SCORE_SELECTOR=SCORE

TARGET_PRESET=OLLAMA

RECON_PRESET=LAB_RECON

##############################################################################
# ==================== 通用参数 ====================
##############################################################################

REQUEST_TIMEOUT=60

TEMPERATURE=0.7

MAX_TOKENS=4096

# 默认模型名称（当自动探测失败且 CLI 未指定 --target-model 时的回退值）
DEFAULT_MODEL_NAME=gpt-4o


# 由 Web 配置中心追加
SCORE_SELECTOR=