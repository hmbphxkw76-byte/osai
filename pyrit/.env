##############################################################################
#  AI-300 平台配置 — 攻击 / 评分器自由组合
##############################################################################
#  用法:
#    PLATFORM_SELECTOR          → 攻击模型来源 (读 CHAT_MODEL)
#    SCORER_PLATFORM_SELECTOR   → 评分器来源   (读 SCORER_MODEL, 不设则复用攻击平台)
##############################################################################

PLATFORM_SELECTOR=OLLAMA

SCORER_PLATFORM_SELECTOR=CUSTOM_SCORER

##############################################################################
# 1.OpenAI认证: Authorization: Bearer <KEY> | 端点: /v1/chat/completions ==
##############################################################################

[OPENAI]
OPENAI_CHAT_ENDPOINT=https://api.openai.com/v1
CHAT_MODEL=gpt-4o
SCORER_MODEL=gpt-4o
OPENAI_CHAT_KEY=your-openai-api-key-here

[OPENAI_SCORER]
OPENAI_CHAT_ENDPOINT=https://api.openai.com/v1
SCORER_MODEL=gpt-4o
OPENAI_CHAT_KEY=your-openai-api-key-here

# ────────────────────────────────────────────────
# 2.Ollama 本地 ─ 认证: Bearer (同上 OpenAI 兼容) ==
# ────────────────────────────────────────────────

[OLLAMA]
OPENAI_CHAT_ENDPOINT=http://192.168.40.198:11434/v1
CHAT_MODEL=qwen3:0.6b
OPENAI_CHAT_KEY=ollama

[OLLAMA_SCORER]
OPENAI_CHAT_ENDPOINT=http://192.168.40.198:11434/v1
SCORER_MODEL=qwen3:1.7b
OPENAI_CHAT_KEY=ollama

# ────────────────────────────────────────────────
# 3.通用 OpenAI 兼容模板 ─ 认证: Bearer (同上) =
#  DeepSeek / Groq / vLLM / 智谱 / 千问 / 月之暗面 / 百川 / Mistral / Perplexity / xAI ...
# ────────────────────────────────────────────────

[CUSTOM]
OPENAI_CHAT_ENDPOINT=https://your-service/v1
CHAT_MODEL=your-model
SCORER_MODEL=your-model
OPENAI_CHAT_KEY=your-api-key

[CUSTOM_SCORER]
OPENAI_CHAT_ENDPOINT=https://api.deepseek.com
SCORER_MODEL= deepseek-v4-flash
OPENAI_CHAT_KEY=sk-76870188c23a492f9994ce1fa5280ea1

# ────────────────────────────────────────────────
# Anthropic Claude ─ 认证: x-api-key: <KEY> | 协议: Messages API === 
# ────────────────────────────────────────────────

[ANTHROPIC]
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CHAT_MODEL=claude-3-sonnet-20240229
SCORER_MODEL=claude-3-sonnet-20240229

[ANTHROPIC_SCORER]
ANTHROPIC_API_KEY=your-anthropic-api-key-here
SCORER_MODEL=claude-3-sonnet-20240229

# ────────────────────────────────────────────────
# Google Gemini ─ 认证: ?key=<KEY> 拼入 URL | 协议: generateContent === 
# ────────────────────────────────────────────────

[GOOGLE_GEMINI]
GEMINI_API_KEY=your-gemini-api-key-here
CHAT_MODEL=gemini-1.5-flash
SCORER_MODEL=gemini-1.5-pro

[GOOGLE_GEMINI_SCORER]
GEMINI_API_KEY=your-gemini-api-key-here
SCORER_MODEL=gemini-1.5-pro


##############################################################################
# ==================== 通用参数 ====================
##############################################################################

REQUEST_TIMEOUT=60

TEMPERATURE=0.7

MAX_TOKENS=4096

# 默认模型名称（当自动探测失败且 CLI 未指定 --target-model 时的回退值）
DEFAULT_MODEL_NAME=default
