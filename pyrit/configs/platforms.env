##############################################################################
# 平台配置 — 攻击模型 + 评分模型 (v11.0)
##############################################################################
# .env 中设置 PLATFORM_SELECTOR / SCORE_SELECTOR 选择下方模式:
#
#   PLATFORM_SELECTOR  → 攻击平台选择器（可选，留空则仅用 --target-url）
#     ATTACK_with_SCORE  = 攻击 + 评分（默认推荐）
#     Only_SCORE         = 仅评分（配合 --target-url + SCORE_SELECTOR）
#     ONLY_ATTACK        = 仅攻击（跳过评分，适合快速压测）
#
#   SCORE_SELECTOR     → 评分平台选择器（可选，覆盖 PLATFORM_SELECTOR 的评分部分）
#     SCORE              = 独立评分节
#
#   自定义 AI 应用典型配置:
#     PLATFORM_SELECTOR=          ← 留空，不加载攻击模型
#     SCORE_SELECTOR=SCORE        ← 只需评分器
#
# 公共变量 (BASE_URL, BASE_API, SCORE_BASE_URL, SCORE_BASE_API 等) 见 configs/shared.env
##############################################################################

# 模式一：攻击 + 评分（默认推荐 — 攻击目标模型，用评分模型打分验证）
[ATTACK_with_SCORE]
ATTACK_URL   = %(BASE_URL)s
ATTACK_API   = %(BASE_API)s
ATTACK_MODEL = %(BASE_MODEL)s

SCORE_URL    = %(SCORE_BASE_URL)s
SCORE_API    = %(SCORE_BASE_API)s
SCORE_MODEL  = %(SCORE_BASE_MODEL)s


# 模式二：仅评分（配合 --target-url 自定义目标，攻击走 CLI 渠道）
[Only_SCORE]
SCORE_URL    = %(SCORE_BASE_URL)s
SCORE_API    = %(SCORE_BASE_API)s
SCORE_MODEL  = %(SCORE_BASE_MODEL)s

# 模式三：仅攻击（跳过评分阶段 — 适合快速压测或无需打分的场景）
[ONLY_ATTACK]
ATTACK_URL   = %(BASE_URL)s
ATTACK_API   = %(BASE_API)s
ATTACK_MODEL = %(BASE_MODEL)s

# 模式四：独立评分节（配合 SCORE_SELECTOR=SCORE 使用）
[SCORE]
SCORE_URL    = %(SCORE_BASE_URL)s
SCORE_API    = %(SCORE_BASE_API)s
SCORE_MODEL  = %(SCORE_BASE_MODEL)s
