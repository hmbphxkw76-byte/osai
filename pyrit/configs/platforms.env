##############################################################################
# 平台配置 — 攻击模型 + 评分模型
##############################################################################
# .env 中设置 PLATFORM_SELECTOR 选择下方三种模式之一:
#   ATTACK_with_SCORE  → 攻击 + 评分（最常用）
#   Only_SCORE         → 只要评分（配合 --target-url 使用）
#   ONLY_ATTACK        → 只要攻击
# 公共变量 (BASE_URL, BASE_API, SCORE_BASE_URL, SCORE_BASE_API 等) 见 configs/shared.env
##############################################################################

# ══════════════════════════════════════════════════════════════════════════
# 平台预设节 — 供 .env 中 PLATFORM_SELECTOR / SCORER_PLATFORM_SELECTOR 引用
# 变量值通过 %(VAR)s 引用 configs/shared.env 中的公共变量
# ══════════════════════════════════════════════════════════════════════════

# 模式一：攻击 + 评分（默认推荐 — 攻击目标模型，用评分模型打分验证）
[ATTACK_with_SCORE]
ATTACK_URL   = %(BASE_URL)s
ATTACK_API   = %(BASE_API)s
ATTACK_MODEL = %(BASE_MODEL)s

SCORE_URL    = %(SCORE_BASE_URL)s
SCORE_API    = %(SCORE_BASE_API)s
SCORE_MODEL  = %(SCORE_BASE_MODEL)s


# 模式二：仅评分（配合 --target-url 自定义目标，攻击走 CLI 指定渠道）
[Only_SCORE]
SCORE_URL    = %(SCORE_BASE_URL)s
SCORE_API    = %(SCORE_BASE_API)s
SCORE_MODEL  = %(SCORE_BASE_MODEL)s

# 模式三：仅攻击（跳过评分阶段 — 适合快速压测或无需打分的场景）
[ONLY_ATTACK]
ATTACK_URL   = %(BASE_URL)s
ATTACK_API   = %(BASE_API)s
ATTACK_MODEL = %(BASE_MODEL)s
