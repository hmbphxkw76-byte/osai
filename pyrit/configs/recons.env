##############################################################################
# 侦查阶段 — 信息收集、端点探测、版本泄露
##############################################################################
# .env: RECON_PRESET=MODELS_RECON | HEALTH_RECON | GET_RECON
# --target-url / --cookie   → CLI 覆盖预设值
# %(VAR)s                   → configparser 插值，引用 configs/shared.env 公共变量
##############################################################################

# ── 本文件专用变量 ──
# 用于 [TARGET_GET_RECON] 本地/内网靶场路径探测（非云端目标，不放入 shared.env）
HTTP_BASE  = http://target:8080             # 本地靶场地址

# ── 侦查预设 ──

# 1：模型列表枚举（GET /v1/models — 摸清目标可用模型清单，侦查第一步）
[TARGET_MODELS_RECON]
TARGET_URL=%(BASE_URL)s/v1/models
TARGET_API_FORMAT=raw
TARGET_HTTP_METHOD=GET
TARGET_EXTRA_HEADERS={"Authorization":"Bearer %(BASE_API)s"}

# 2：健康检查探测（GET /health — 可能泄露版本号、依赖库、运行时环境）
[TARGET_HEALTH_RECON]
TARGET_URL=%(BASE_URL)s/health
TARGET_API_FORMAT=raw
TARGET_HTTP_METHOD=GET

# 3：通用信息收集（GET 任意路径 — SESSION_ID 来自 shared.env）
[TARGET_GET_RECON]
TARGET_URL=%(HTTP_BASE)s/api/info
TARGET_API_FORMAT=raw
TARGET_HTTP_METHOD=GET
TARGET_COOKIE=session_id=%(SESSION_ID)s
