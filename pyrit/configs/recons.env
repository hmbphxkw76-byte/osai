##############################################################################
# 侦查阶段 — 信息收集、端点探测、版本泄露 (v11.0)
##############################################################################
# .env: RECON_PRESET=MODELS_RECON | HEALTH_RECON | GET_RECON
# %(VAR)s → configparser 插值，引用 configs/shared.env 公共变量
#
# 🆕 v11.0:
#   TARGET_AUTH 统一认证（自动检测格式）
#   TARGET_SSL_SKIP 统一 SSL 控制
#   临时凭证通过 --auth-file configs/tokens/*.txt 注入
#   TARGET_HTTP_METHOD / TARGET_API_FORMAT 仅用于非标准侦查路径覆盖
##############################################################################

# ── 侦查预设 ──

# 1：模型列表枚举（GET /v1/models — 摸清目标可用模型清单）
[TARGET_MODELS_RECON]
TARGET_URL=%(BASE_URL)s/v1/models
TARGET_API_FORMAT=raw
TARGET_HTTP_METHOD=GET
TARGET_AUTH=%(BASE_API)s

# 2：健康检查探测（GET /health — 可能泄露版本号、依赖库、运行时环境）
[TARGET_HEALTH_RECON]
TARGET_URL=%(BASE_URL)s/health
TARGET_API_FORMAT=raw
TARGET_HTTP_METHOD=GET

# 3：Ollama 服务侦察（GET /api/tags — 枚举已加载模型）
[TARGET_OLLAMA_RECON]
TARGET_URL=%(BASE_URL)s/api/tags
TARGET_API_FORMAT=raw
TARGET_HTTP_METHOD=GET

# 4：Lab 内网目标首页侦察（Cookie 认证 + HTTPS 自签）
# 用法: python main.py --auth-file configs/tokens/cookie.txt --ssl-skip --phase probe
[TARGET_LAB_RECON]
TARGET_URL=https://192.168.0.20/
TARGET_API_FORMAT=raw
TARGET_HTTP_METHOD=GET
TARGET_SSL_SKIP=1
