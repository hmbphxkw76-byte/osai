##############################################################################
# 共享凭证 — 全局变量池，修改一处即可影响所有配置文件
##############################################################################
# 所有 .env 配置文件通过 configparser 的 %(VAR)s 语法自动插值引用此文件
# 如需切换目标平台或评分模型，只需修改此文件

# ═══ 攻击目标 — 硅基流动 ═══
BASE_URL   = https://api.siliconflow.cn                                 # 目标平台地址
BASE_API   = sk-uqmmxbngygdknukbdzjevoevsgyiptgvgtvxwugfalxchccl      # 目标平台 API Key
BASE_MODEL = Qwen/Qwen3-8B                                              # 默认攻击模型

# ═══ 评分模型 — 智谱 GLM ═══
SCORE_BASE_URL   = https://open.bigmodel.cn/api/paas/v4                # 评分平台地址
SCORE_BASE_API   = 63f2e11b222a4af5bde7357ec58fd70e.8oogCzwisIih1on4  # 评分平台 API Key
SCORE_BASE_MODEL = GLM-5.1                                              # 默认评分模型


# ═══ 高级攻击场景凭证 — targets.env 中 [TARGET_JWT_ONLY] / [TARGET_COOKIE_UA] 引用 ═══
# 仅在需要使用 JWT 认证或 Cookie 伪装等高级场景时填写
JWT_TOKEN     = eyJhbGciOi...            # JWT Bearer Token
SESSION_ID    = abc123def456             # 会话 ID
CSRF_TOKEN    = xyz789                   # CSRF Token（可选）
USER_AGENT    = Security-Tester/1.0      # 浏览器 UA 伪装
COOKIE_STRING = session_id=%(SESSION_ID)s; user_role=admin; csrf_token=%(CSRF_TOKEN)s
