##############################################################################
# 共享平台配置 — 全局变量池 (v11.0)
##############################################################################
# 所有 .env 配置文件通过 configparser 的 %(VAR)s 语法自动插值引用此文件
# 切换目标平台或评分模型，只需修改此文件
#
# ── 变量分类 ──
#   稳定平台变量（本文件）: 平台地址、API Key、模型名
#   临时测试凭证（configs/tokens/）: JWT、Cookie、Session
#   CLI 覆盖: --target-url / --auth / --auth-file / PYRIT_AUTH
##############################################################################

# ═══ 攻击目标平台 ═══
BASE_URL   = http://192.168.0.20:11434                                    # 目标平台地址 (Ollama 本地部署)
BASE_API   = None                                                     # 目标平台 API Key (Ollama 无需认证)
BASE_MODEL = qwen3:0.6b                                           # 默认攻击模型 (probe 阶段自动探测)

# ═══ 评分平台 ═══
SCORE_BASE_URL   = https://api.siliconflow.cn/v1                        # 评分平台地址 (本地 Ollama)
SCORE_BASE_API   = sk-uqmmxbngygdknukbdzjevoevsgyiptgvgtvxwugfalxchccl  # 评分平台 API Key (Ollama 无需认证，填占位符即可)
SCORE_BASE_MODEL = Qwen/Qwen3-8B                                           # 默认评分模型 (⚠ 0.6b 推理弱，建议 8b+)


# ═══ 临时凭证 — 统一存放于 configs/tokens/ ═══
# JWT、Cookie、Session 等每轮测试变动的凭证，改用独立文件管理：
#   configs/tokens/jwt.txt          → JWT Bearer Token
#   configs/tokens/cookie.txt       → Cookie 字符串
#   configs/tokens/api_key.txt      → API Key
#
# 使用方式（优先级从高到低）:
#   1. --auth-file configs/tokens/jwt.txt     ← 推荐，凭证不入命令行
#   2. PYRIT_AUTH=xxx                         ← .env 环境变量
#   3. 预设 TARGET_AUTH（本文件稳定 API Key）  ← 向后兼容
#
# 注意: 本文件只放平台级稳定 API Key (BASE_API / SCORE_BASE_API)
#       不要在这里放 JWT / Cookie / Session 等每次变动的凭证！
