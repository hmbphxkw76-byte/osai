##############################################################################
# 红队攻击 — 针对 AI 模型/应用的攻击预设 (v11.0)
##############################################################################
# .env: TARGET_PRESET=API_KEY | NO_AUTH | INTERNAL_JWT | WEB_COOKIE | SELF_SIGNED
# %(VAR)s → configparser 插值，引用 configs/shared.env 公共变量
#
# 🆕 v11.0 核心变化:
#   ✅ TARGET_AUTH 统一认证凭证（自动检测 JWT / Cookie / API Key / 自定义Header）
#   ✅ TARGET_SSL_SKIP 替代 TARGET_NO_SSL
#   ✅ 稳定变量在 shared.env，临时凭证在 configs/tokens/
#   ✅ 删 TARGET_JWT/TARGET_COOKIE/TARGET_EXTRA_HEADERS → 合并为 TARGET_AUTH
#   ✅ 删 TARGET_API_FORMAT/TARGET_HTTP_METHOD/TARGET_USER_AGENT → probe 自动探测
#
# CLI 认证优先级: --auth > --auth-file > PYRIT_AUTH > TARGET_AUTH(预设)
##############################################################################

# ── 基础场景（覆盖 90% 攻击面）──

# 1：API Key 认证（OpenAI 兼容格式）
[TARGET_API_KEY]
TARGET_URL=%(BASE_URL)s/v1/chat/completions
TARGET_AUTH=%(BASE_API)s

# 2：无认证（vLLM/Ollama/TGI 等本地自部署模型）
[TARGET_NO_AUTH]
TARGET_URL=%(BASE_URL)s/v1/chat/completions

# 2b：Ollama 本地部署（开放 /api/chat）
# 用法: python main.py --target-url http://192.168.0.20:11434 --target-type model --phase probe
[TARGET_OLLAMA]
TARGET_URL=%(BASE_URL)s/api/chat


# ── 高级场景 — TARGET_AUTH 留空，通过 --auth-file 或 PYRIT_AUTH 注入 ──

# 3：內网自部署 + JWT 认证
# 用法: echo "eyJhbGci..." > configs/tokens/jwt.txt
#       python main.py --auth-file configs/tokens/jwt.txt --phase probe
[TARGET_INTERNAL_JWT]
TARGET_URL=%(BASE_URL)s/api/chat

# 4：Web AI Chat + Cookie 认证（模拟 Web 端用户）
# 用法: echo "session_id=xxx; user_role=admin" > configs/tokens/cookie.txt
#       python main.py --auth-file configs/tokens/cookie.txt --phase probe
[TARGET_WEB_COOKIE]
TARGET_URL=%(BASE_URL)s/v1/predict

# 5：HTTPS 自签证书 + 自定义 Header 认证
# 用法: python main.py --target-url URL --auth '{"X-API-Key":"sk-xxx"}' --ssl-skip --phase probe
[TARGET_SELF_SIGNED]
TARGET_URL=%(BASE_URL)s/v1/chat/completions
TARGET_AUTH={"X-API-Key":"%(BASE_API)s"}
TARGET_SSL_SKIP=1

# 6：Lab 内网 Web AI 应用（Cookie + HTTPS 自签）
# 用法: python main.py --auth-file configs/tokens/cookie.txt --ssl-skip --phase probe
[TARGET_LAB]
TARGET_URL=https://192.168.0.20/
TARGET_SSL_SKIP=1
# TARGET_AUTH 留空，通过 --auth-file configs/tokens/cookie.txt 注入
# TARGET_JWT / TARGET_COOKIE / TARGET_EXTRA_HEADERS → 改用 TARGET_AUTH
# TARGET_NO_SSL                                      → 改用 TARGET_SSL_SKIP
# TARGET_API_FORMAT / TARGET_HTTP_METHOD             → probe 自动探测
# TARGET_USER_AGENT / TARGET_CONTENT_TYPE             → 已移除
