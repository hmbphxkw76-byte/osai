##############################################################################
# 红队攻击 — 针对 AI 模型/应用的攻击预设
##############################################################################
# .env: TARGET_PRESET=API_KEY | NO_AUTH       （典型场景）
#       TARGET_PRESET=VISION | JWT_ONLY | COOKIE_UA  （特殊场景）
# --target-url / --cookie   → CLI 覆盖预设值
# %(VAR)s                   → configparser 插值，引用 configs/shared.env 公共变量
# ──────────────────────────────────────────────────────────────────────────
# 侦查阶段请用 configs/recons.env（RECON_PRESET=MODELS_RECON 等）
##############################################################################

# ── 典型场景（覆盖 90% 攻击面）──

# 1：主流 OpenAI 标准模式（Bearer Token 认证 — 覆盖 90%+ 商用 AI API）
[TARGET_API_KEY]
TARGET_URL=%(BASE_URL)s/v1/chat/completions
TARGET_EXTRA_HEADERS={"Authorization":"Bearer %(BASE_API)s"}

# 2：无认证（vLLM/Ollama/TGI 等本地自部署模型，无需 API Key）
[TARGET_NO_AUTH]
TARGET_URL=%(BASE_URL)s/v1/chat/completions


# ── 高级场景 ──
# JWT_TOKEN / COOKIE_STRING / USER_AGENT 等变量已在 configs/shared.env 定义
# 修改这些变量只需编辑 shared.env 即可

# 1：多模态 Vision API（图片注入攻击面 — 配置同 API_KEY，攻击行为走 vision 专用 payload）
[TARGET_VISION]
TARGET_URL=%(BASE_URL)s/v1/chat/completions
TARGET_EXTRA_HEADERS={"Authorization":"Bearer %(BASE_API)s"}

# 2：JWT Bearer Token 认证（JWT Token 来自 shared.env）
[TARGET_JWT_ONLY]
TARGET_URL=%(BASE_URL)s/api/chat
TARGET_API_FORMAT=raw
TARGET_JWT=%(JWT_TOKEN)s

# 3：Cookie + 浏览器 UA 伪装（模拟 Web 端 AI Chat 用户 — Cookie/UA 来自 shared.env）
[TARGET_COOKIE_UA]
TARGET_URL=%(BASE_URL)s/v1/predict
TARGET_API_FORMAT=raw
TARGET_COOKIE=%(COOKIE_STRING)s
TARGET_USER_AGENT=%(USER_AGENT)s





