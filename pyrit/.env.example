# =============================================================================
# OffSec AI-300 环境变量配置模板 (v12.0 — 7-Layer Architecture)
# 使用方法: 复制为 .env 并按实际环境修改
#   cp .env.example .env
# =============================================================================

# ── 默认平台选择器（攻击者模型所在平台） ──
PLATFORM_SELECTOR=ZHIPU

# ── 评分器独立平台（可选，不设置则复用 PLATFORM_SELECTOR） ──
# SCORER_PLATFORM_SELECTOR=ZHIPU

# ── 全局参数 ──
TEMPERATURE=0.7
MAX_TOKENS=4096
REQUEST_TIMEOUT=60

# =============================================================================
# 🆕 L1-L6 七层架构选择器
# =============================================================================
# GARAK_MODE — AI 安全侦查模式 (L1)
#   baseline | deep | targeted | disabled
GARAK_MODE=baseline

# PROMPTFOO_ENABLED — 启用 Promptfoo 评估引擎 (L3c/L5)
PROMPTFOO_ENABLED=true

# RAG_MODE — RAG 专项攻击模式 (L3c)
#   standard | deep | injection-only | disabled
RAG_MODE=standard

# AGENT_ABUSE_MODE — Agent 工具滥用模式 (L3d)
#   enabled | disabled
AGENT_ABUSE_MODE=enabled

# MODEL_EXTRACTION_MODE — 模型提取攻击模式 (L3e)
#   enabled | disabled
MODEL_EXTRACTION_MODE=enabled

# MULTI_AGENT_MODE — 多 Agent 攻击模式 (L4)
#   sequential | parallel | targeted | disabled
MULTI_AGENT_MODE=targeted

# REPORT_STYLE — 报告输出风格 (L6)
#   offsec | mitre | owasp | custom
REPORT_STYLE=offsec

# =============================================================================
# 平台配置节 — 每个平台需配置 3 个字段:
#   OPENAI_CHAT_ENDPOINT   API 端点
#   OPENAI_CHAT_KEY        API 密钥
#   CHAT_MODEL             攻击者模型名
#   SCORER_MODEL           评分器模型名（可选，通常比 CHAT_MODEL 更强）
# =============================================================================

[ZHIPU]
OPENAI_CHAT_ENDPOINT=https://open.bigmodel.cn/api/paas/v4
OPENAI_CHAT_KEY=your_zhipu_api_key_here
CHAT_MODEL=GLM-4.7-Flash
SCORER_MODEL=GLM-5.2

# [QWEN]
# OPENAI_CHAT_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_CHAT_KEY=your_qwen_api_key_here
# CHAT_MODEL=qwen-turbo
# SCORER_MODEL=qwen-max

# [DEEPSEEK]
# OPENAI_CHAT_ENDPOINT=https://api.deepseek.com/v1
# OPENAI_CHAT_KEY=your_deepseek_api_key_here
# CHAT_MODEL=deepseek-chat
# SCORER_MODEL=deepseek-chat

# [OPENAI]
# OPENAI_CHAT_ENDPOINT=https://api.openai.com/v1
# OPENAI_CHAT_KEY=sk-your_openai_key_here
# CHAT_MODEL=gpt-4o-mini
# SCORER_MODEL=gpt-4o

# [OLLAMA]
# OPENAI_CHAT_ENDPOINT=http://localhost:11434/v1
# OPENAI_CHAT_KEY=ollama
# CHAT_MODEL=llama3.1:8b
# SCORER_MODEL=qwen3:14b

# [GOOGLE_GEMINI]
# OPENAI_CHAT_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
# OPENAI_CHAT_KEY=your_gemini_api_key_here
# CHAT_MODEL=gemini-1.5-flash
# SCORER_MODEL=gemini-1.5-pro

# [ANTHROPIC]
# OPENAI_CHAT_ENDPOINT=https://api.anthropic.com/v1/messages
# OPENAI_CHAT_KEY=your_anthropic_api_key_here
# CHAT_MODEL=claude-3-sonnet-20240229
# SCORER_MODEL=claude-3-opus-20240229
