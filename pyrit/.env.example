# ============================================================
# PyRIT Red Team AI - Environment Configuration
# ============================================================

# --- Target Model Configuration ---
TARGET_MODEL_PROVIDER=openai
TARGET_MODEL_NAME=gpt-4o
TARGET_MODEL_ENDPOINT=http://localhost:8080/v1
TARGET_API_KEY=your-api-key-here
TARGET_API_VERSION=2024-02-15-preview

# --- Orchestrator Settings ---
ORCHESTRATOR_MAX_CONCURRENCY=5
ORCHESTRATOR_MAX_TURNS=10
ORCHESTRATOR_TIMEOUT_SECONDS=300

# --- Budget Control ---
BUDGET_TOTAL_TOKENS=1000000
BUDGET_MAX_COST_USD=50.0
RATE_LIMIT_RPM=60
RATE_LIMIT_TPM=100000

# --- Feedback Loop ---
FEEDBACK_ENABLED=true
FEEDBACK_UCB1_EXPLORATION_RATE=0.2
FEEDBACK_EARLY_STOP_THRESHOLD=0.8
FEEDBACK_MIN_ITERATIONS=3

# --- Attack Execution ---
ATTACK_DEFAULT_STRATEGY=crescendo
ATTACK_JAILBREAK_ENABLED=true
ATTACK_XPIA_ENABLED=true
ATTACK_RAG_ENABLED=true
ATTACK_AGENT_ABUSE_ENABLED=true
ATTACK_EXTRACTION_ENABLED=true

# --- Multi-Agent Attack ---
MULTI_AGENT_ENABLED=true
MULTI_AGENT_MAX_AGENTS=5
MULTI_AGENT_SESSION_TIMEOUT=600

# --- Promptfoo Integration ---
PROMPTFOO_TEMPLATES_DIR=../promptfoo/templates
PROMPTFOO_EVAL_ENABLED=false

# --- Output ---
OUTPUT_DIR=./outputs
OUTPUT_FORMAT=json
LOG_LEVEL=INFO
SAVE_CONVERSATIONS=true

# --- Database ---
DATABASE_URL=sqlite:///outputs/results/pyrit_redteam.db

# --- Target Presets ---
# Options: basic_llm, rag_system, agent_system, multi_agent, custom
TARGET_PRESET=basic_llm

# --- Platform Selector ---
# L2: orchestration / L3: attack_execution / L4: multi_agent
PLATFORM_SELECTOR=L3
