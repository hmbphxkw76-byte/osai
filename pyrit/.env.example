# ════════════════════════════════════════════════════════════════
# AI-300 Framework - 环境变量配置模板
# ════════════════════════════════════════════════════════════════
#
# 使用方式：
#   1. 复制本文件为 .env（cp .env.example .env）
#   2. 填入真实凭据值
#   3. .env 已在 .gitignore 中，不会被提交
#
# 在 YAML 配置中通过 ${VAR_NAME} 引用环境变量，例如：
#   api_key: "${SCORES_API_KEY}"
#   base_url: "${SCORES_BASE_URL:-http://localhost:11434/v1}"
#
# 支持两种语法：
#   ${VAR}            — 直接引用，未设置时返回空字符串
#   ${VAR:-default}   — 带默认值，未设置时使用 default
#
# 加载优先级：环境变量 > .env 文件 > YAML 默认值
# ════════════════════════════════════════════════════════════════

# ── SPA 聊天目标（config/targets/spa_target.yaml）──
SPA_TARGET_URL=your_spa_target_url_here
SPA_USERNAME=your_username_here
SPA_PASSWORD=your_password_here
## sso / credentials / manual / none
SPA_MODE=sso


# ── LLM API 攻击目标（config/targets/llm_api_target.yaml）──
# 注意：这是被攻击的目标 LLM，与下方评分器后端相互独立
#
# LLM_API_ENDPOINT — 模型服务地址（Ollama 默认 http://192.168.0.23:11434/v1，智谱 https://open.bigmodel.cn/api/paas/v4）
# LLM_API_MODEL    — 模型名称（Ollama 默认 qwen3:0.6b，智谱 glm-4-flash）
# LLM_API_KEY      — API Key（Ollama 默认 not-needed，云端平台必填）
#
# 切换平台时修改下方值即可，YAML 通过 ${VAR:-default} 携带默认值
LLM_API_ENDPOINT=http://192.168.0.23:11434/v1
LLM_API_MODEL=qwen3:0.6b
LLM_API_KEY=not-needed


# ── HTTP API 目标（config/targets/http_target.yaml）──
HTTP_API_TOKEN=your_bearer_token_here


# ── 评分器 / 生成器 LLM 后端（config/scores/*.yaml）──
# 统一变量：适用于 scorer_backends.yaml / generator_backends.yaml
# 后台自动判断：provider=ollama 时跳过 API Key 校验；provider=openai 等云端平台未配置时提示
#
# 评分器回退链（确保评分器失效不中断流水线）：
#   1. openai_compatible  — 云端高精度 API（需要 SCORES_API_KEY）
#   2. local_provider     — 本地模型服务（Ollama，无需认证）
#   3. objective_target   — 复用攻击目标作为评分器后端
#   4. static_prompt_injection — 规则评分器兜底（无需 LLM，内置注入检测）
#   5. 无评分器           — PyRIT 默认行为（攻击照常执行，仅缺少评分）
#
# SCORES_BASE_URL   — 模型服务地址（Ollama 默认 http://localhost:11434/v1，智谱默认 https://open.bigmodel.cn/api/paas/v4）
# SCORES_API_KEY    — API Key（Ollama 默认 not-needed，智谱等云端平台必填）
# SCORES_MODEL_NAME — 模型名称（Ollama 默认 qwen3:0.6b，智谱默认 glm-4-flash）
#
# 切换后端时修改下方值即可，各 YAML 通过 ${VAR:-default} 携带不同默认值
SCORES_BASE_URL=http://localhost:11434/v1
SCORES_API_KEY=not-needed
SCORES_MODEL_NAME=qwen3:0.6b


