# ════════════════════════════════════════════════════════════════
# AI-300 Framework - 环境变量配置模板
# ════════════════════════════════════════════════════════════════
#
# 使用方式：
#   1. 复制本文件为 .env（cp .env.example .env）
#   2. 填入真实凭据值
#   3. .env 已在 .gitignore 中，不会被提交
#
# 在 YAML 配置中通过 ${VAR_NAME} 引用环境变量，例如：
#   api_key: "${LLM_API_KEY}"
#   username: "${SPA_USERNAME}"
#
# 加载优先级：环境变量 > .env 文件 > YAML 默认值
# ════════════════════════════════════════════════════════════════

# ── SPA 聊天目标（spa_target.yaml）──
SPA_TARGET_URL=your_spa_target_url_here
SPA_USERNAME=your_username_here
SPA_PASSWORD=your_password_here
## sso / credentials / manual / none
SPA_MODE=sso


# ── LLM API 目标（llm_api_target.yaml）──
# Ollama 本地填 not-needed；云端平台填真实 API Key
LLM_API_KEY=not-needed

# ── HTTP API 目标（http_target.yaml）──
HTTP_API_TOKEN=your_bearer_token_here

# ── 评分器 LLM 后端（config/scores/zhipu.yaml）──
ZHIPUAI_API_KEY=your_zhipu_api_key_here

# ── 其他云端平台 API Key（按需配置）──
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# BAIDU_API_KEY=
# MINIMAX_API_KEY=
