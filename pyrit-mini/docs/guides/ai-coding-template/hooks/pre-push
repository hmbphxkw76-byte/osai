#!/bin/sh
# pre-push hook — 自动安装见 INSTALL_HOOKS_CMD
# 由 init.py 将 ${TEST_CMD} 等替换为真实命令。
echo "[gate] pre-push checks..."
if ! ${TEST_CMD} >/dev/null 2>&1; then echo "[BLOCK] tests failed"; exit 1; fi
if ! ${DRIFT_CMD} >/dev/null 2>&1; then echo "[BLOCK] drift detected"; exit 1; fi
# 跨模型一致性为 WARNING，不阻断 push
${CROSSMODEL_CMD} || echo "[WARN] cross-model issues found (non-blocking)"
echo "[gate] PASS"; exit 0
