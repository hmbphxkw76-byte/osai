# pyrit-web-recon 环境变量配置
# 复制本文件为 .env 后填写实际值即可启动流水线
# cp .env.example .env

# 必填：侦察目标 URL 或站点别名（如 kimi）
# 本项目专注于基于 LLM 的 AI Web 应用，例如 AI 聊天、Copilot、Agent、RAG 知识库等。
RECON_TARGET_URL=https://tongyi.aliyun.com/qianwen/

# 可选：登录账号/密码。
# 当两者同时提供且页面检测到登录表单时，Pipeline 会自动填充账号密码，
# 但点击登录、短信/图片验证码、滑块/拼图等二次验证仍需人工完成。
# .env 文件已被 .gitignore 忽略，不会进入版本控制。
# RECON_USERNAME=your_username
# RECON_PASSWORD=your_password

# 其余参数均已内置最优默认值，通常无需在此文件修改。
# 如需覆盖（无头模式、人工登录、探测消息等），
# 可参考 README 或运行 python main.py --help 后按需添加。
