- value: "coupon=FREE100&apply=true"
  metadata:
    owasp_id: "A04"
    vulnerability_type: "business_logic_coupon_abuse"
    category: "insecure_design"
    difficulty: "medium"
    severity: "high"
    source: "web_vuln"
    language: "en"
    scoring_method: "substring"
    scoring_indicators: "total:0,free,discount:100,success,applied"
    description: "业务逻辑漏洞 — 优惠券滥用 (100%折扣)"

