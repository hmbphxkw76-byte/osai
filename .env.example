# ============================================================
# RedTeam-AI 环境变量模板
# 使用方式: cp .env.example .env 并填入实际值
# .env 已在 .gitignore 中，不会被提交到仓库
# ============================================================

# ==================================================================
#  Judge LLM 评分配置（可选 — 启用 LLM-as-Judge 高精度评分）
# ==================================================================
#  未配置时默认使用本地 FastGrayscale/Hybrid 评分器。
#  所有平台均使用 OpenAI 兼容的 /v1/chat/completions 格式。

# ------------------------------------------------------------------
#  本机 / 自部署（免费，无需 API Key）
# ------------------------------------------------------------------

# Ollama (http://localhost:11434)
# REDTEAM_JUDGE_ENDPOINT=http://localhost:11434/v1/chat/completions
# REDTEAM_JUDGE_MODEL=qwen2.5:7b

# LM Studio (http://localhost:1234)
# REDTEAM_JUDGE_ENDPOINT=http://localhost:1234/v1/chat/completions
# REDTEAM_JUDGE_MODEL=default

# vLLM (http://localhost:8000)
# REDTEAM_JUDGE_ENDPOINT=http://localhost:8000/v1/chat/completions
# REDTEAM_JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct

# LocalAI (http://localhost:8080)
# REDTEAM_JUDGE_ENDPOINT=http://localhost:8080/v1/chat/completions
# REDTEAM_JUDGE_MODEL=gpt-4

# ------------------------------------------------------------------
#  国际云平台
# ------------------------------------------------------------------

# OpenAI
# REDTEAM_JUDGE_ENDPOINT=https://api.openai.com/v1/chat/completions
# REDTEAM_JUDGE_API_KEY=sk-your-key
# REDTEAM_JUDGE_MODEL=gpt-4o-mini

# Azure OpenAI (注意: 用 api-key 头而非 Bearer，endpoint 含 deployment)
# REDTEAM_JUDGE_ENDPOINT=https://{resource}.openai.azure.com/openai/deployments/{deployment}/chat/completions?api-version=2024-08-01-preview
# REDTEAM_JUDGE_API_KEY=your-azure-key
# REDTEAM_JUDGE_MODEL=gpt-4o-mini

# Anthropic Claude (需第三方 OpenAI 兼容代理)
# REDTEAM_JUDGE_ENDPOINT=https://api.anthropic.com/v1/chat/completions
# REDTEAM_JUDGE_API_KEY=sk-ant-xxx
# REDTEAM_JUDGE_MODEL=claude-3-5-haiku-latest

# Mistral
# REDTEAM_JUDGE_ENDPOINT=https://api.mistral.ai/v1/chat/completions
# REDTEAM_JUDGE_API_KEY=your-mistral-key
# REDTEAM_JUDGE_MODEL=mistral-small-latest

# Groq (超快推理，免费额度)
# REDTEAM_JUDGE_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# REDTEAM_JUDGE_API_KEY=gsk_your-key
# REDTEAM_JUDGE_MODEL=llama-3.1-8b-instant

# xAI Grok
# REDTEAM_JUDGE_ENDPOINT=https://api.x.ai/v1/chat/completions
# REDTEAM_JUDGE_API_KEY=xai-your-key
# REDTEAM_JUDGE_MODEL=grok-2

# Perplexity
# REDTEAM_JUDGE_ENDPOINT=https://api.perplexity.ai/chat/completions
# REDTEAM_JUDGE_API_KEY=pplx-your-key
# REDTEAM_JUDGE_MODEL=sonar

# ------------------------------------------------------------------
#  国内云平台
# ------------------------------------------------------------------

# 智谱 GLM (open.bigmodel.cn)
# REDTEAM_JUDGE_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
# REDTEAM_JUDGE_API_KEY=你的智谱API-Key
# REDTEAM_JUDGE_MODEL=glm-4-flash          # 免费/便宜，推荐评分用

# DeepSeek (api.deepseek.com)
# REDTEAM_JUDGE_ENDPOINT=https://api.deepseek.com/v1/chat/completions
# REDTEAM_JUDGE_API_KEY=sk-your-key
# REDTEAM_JUDGE_MODEL=deepseek-chat

# 硅基流动 SiliconFlow (api.siliconflow.cn — 便宜，模型全)
# REDTEAM_JUDGE_ENDPOINT=https://api.siliconflow.cn/v1/chat/completions
# REDTEAM_JUDGE_API_KEY=sk-your-key
# REDTEAM_JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct

# 阿里百炼 / 通义千问 (dashscope.aliyuncs.com)
# REDTEAM_JUDGE_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# REDTEAM_JUDGE_API_KEY=sk-your-key
# REDTEAM_JUDGE_MODEL=qwen-turbo

# 月之暗面 Moonshot / Kimi (api.moonshot.cn)
# REDTEAM_JUDGE_ENDPOINT=https://api.moonshot.cn/v1/chat/completions
# REDTEAM_JUDGE_API_KEY=sk-your-key
# REDTEAM_JUDGE_MODEL=moonshot-v1-8k

# 零一万物 Yi (api.lingyiwanwu.com)
# REDTEAM_JUDGE_ENDPOINT=https://api.lingyiwanwu.com/v1/chat/completions
# REDTEAM_JUDGE_API_KEY=your-api-key
# REDTEAM_JUDGE_MODEL=yi-large

# MiniMax (api.minimax.chat)
# REDTEAM_JUDGE_ENDPOINT=https://api.minimax.chat/v1/chat/completions
# REDTEAM_JUDGE_API_KEY=your-api-key
# REDTEAM_JUDGE_MODEL=abab6.5s-chat

# 百度千帆 ERNIE (需先启用 OpenAI 兼容模式)
# REDTEAM_JUDGE_ENDPOINT=https://qianfan.baidubce.com/v2/chat/completions
# REDTEAM_JUDGE_API_KEY=your-access-token
# REDTEAM_JUDGE_MODEL=ernie-speed-128k

# 字节豆包 / 火山引擎 (ark.cn-beijing.volces.com)
# REDTEAM_JUDGE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
# REDTEAM_JUDGE_API_KEY=your-api-key
# REDTEAM_JUDGE_MODEL=doubao-lite-32k

# 讯飞星火 (spark-api-open.xf-yun.com)
# REDTEAM_JUDGE_ENDPOINT=https://spark-api-open.xf-yun.com/v1/chat/completions
# REDTEAM_JUDGE_API_KEY=your-api-key
# REDTEAM_JUDGE_MODEL=generalv3.5

# ------------------------------------------------------------------
#  评分器推荐（按场景选）
# ------------------------------------------------------------------
#  快速验证 / CI               → 本地 Ollama qwen2.5:0.5b + fast_grayscale
#  日常开发 / 自用              → Groq (免费) / 智谱 glm-4-flash (免费)
#  考试 / 离线                  → 不配 Judge，用 Hybrid/FastGrayscale
#  高精度 / 正式报告            → gpt-4o-mini / deepseek-chat / qwen-turbo
#  抓评分回归 bug               → SiliconFlow 切不同模型对比

# ==================================================================
#  考试 / 离线模式（OSAI AI-300 考试期间必须启用）
# ==================================================================
# REDTEAM_NO_JUDGE_LLM=1

# ==================================================================
#  当前激活配置（取消注释即可生效）
# ==================================================================
# REDTEAM_JUDGE_ENDPOINT=http://localhost:11434/v1/chat/completions
# REDTEAM_JUDGE_API_KEY=not-needed
# REDTEAM_JUDGE_MODEL=qwen2.5:7b
