# ============================================================================
# PyRIT 环境配置模板 — 密钥与端点
# ============================================================================
# 本文件仅存放 API Key / Endpoint / Model Name（PyRIT 原生约定）
# 结构配置见同目录 .pyrit_conf
# 运行时参数（temperature/epsilon/datasets 等）通过命令行 --flags 传入
#
# 使用方式:
#   1. 复制本文件为 .env: cp .env.example .env
#   2. 填入实际的 API Key 和 Endpoint
#   3. .env 已被 .gitignore 忽略，不会提交
# ============================================================================

# ─── 目标模型 (被攻击的 LLM) ─────────────────────────────────
# Registry 名称: openai_chat (标记为 default_objective_target)
# 原生 TargetInitializer 自动注册并标记
OPENAI_CHAT_ENDPOINT=https://your-api-endpoint/v1
OPENAI_CHAT_MODEL=your-model-name
OPENAI_CHAT_KEY=your-api-key-here

# ─── 评分器模型 (Judge LLM) ──────────────────────────────────
# Registry 名称: objective_scorer_chat
# 原生 ScorerInitializer 使用此目标构建评分器
#
# 评分器模型分层推荐 (v38):
#   T1 金标准 — JSON 100% 遵从, F1≈0.90+ (GPT-4o, Claude-3.5-Sonnet)
#   T2 推荐   — JSON 遵从度高, F1≈0.85-0.90 (Qwen2.5-72B, Llama-3.1-70B)
#   T3 可用   — JSON 不稳定, 需 response_parser.py 兜底 (DeepSeek-V3 via SiliconFlow)
#
# 学术依据:
#   - HarmBench (arXiv:2402.04249) §4.3: F1>0.9 时 ASR 可信
#   - LLM-as-a-Judge (arXiv:2306.05685): 70B+ 模型一致性 80%+
#   - Qwen2.5 TR (arXiv:2412.15115): JSON 结构化输出官方优化
#
# 推荐: Qwen/Qwen2.5-72B-Instruct (T2, 非Azure平台最佳选择)
OBJECTIVE_SCORER_CHAT_ENDPOINT=https://your-judge-endpoint/v1
OBJECTIVE_SCORER_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct
OBJECTIVE_SCORER_CHAT_KEY=your-judge-api-key

# ─── 备用评分器 (v38.2 双评分器热切换) ─────────────────────
# 当主评分器超时/失败时, 自动用备用评分器重评分
# 推荐: deepseek-ai/DeepSeek-V3.2 (671B MoE, JSON mode 已支持)
# 留空则禁用双评分器热切换
BACKUP_SCORER_CHAT_ENDPOINT=https://your-backup-judge-endpoint/v1
BACKUP_SCORER_CHAT_MODEL=deepseek-ai/DeepSeek-V3.2
BACKUP_SCORER_CHAT_KEY=your-backup-judge-api-key

# ─── 对抗模型 (多轮攻击策略生成) ─────────────────────────────
# Registry 名称: adversarial_chat
# TAP / Crescendo / PAIR / Role-Play 等多轮技术必需
# 可复用评分器端点, 也可配置独立端点
ADVERSARIAL_CHAT_ENDPOINT=${OBJECTIVE_SCORER_CHAT_ENDPOINT}
ADVERSARIAL_CHAT_MODEL=${OBJECTIVE_SCORER_CHAT_MODEL}
ADVERSARIAL_CHAT_KEY=${OBJECTIVE_SCORER_CHAT_KEY}

# ─── L5: Tool Calling Target (可选) ─────────────────────────
# 用于 Agent 攻击 (XPIA/MCP/Multi-Agent) 的 OpenAIResponseTarget
# 启用 --tool-calling 时使用这些环境变量
# 如果不配置, 自动复用 OPENAI_CHAT_* 端点
# OPENAI_RESPONSES_ENDPOINT=https://your-api-endpoint/v1
# OPENAI_RESPONSES_MODEL=your-model-name
# OPENAI_RESPONSES_KEY=your-api-key-here

# ─── L5: Azure Blob Storage (可选, XPIA 投递通道) ───────────
# 用于 XPIA processing_callback 将注入文本投递到 Blob
# 如果不配置, 自动降级为本地文件模拟
# AZURE_BLOB_CONTAINER_URL=https://yourstorage.blob.core.windows.net/your-container
# AZURE_BLOB_SAS_TOKEN=your-sas-token-here

# ─── 统一目标 URL (可选) ─────────────────────────────────────
# 用于 --target-url 统一入口, 自动判别目标类型 (LLM Web 应用 / LLM API 平台)
# 也可通过命令行 --target-url 覆盖
# 优先级: 命令行 > TARGET_URL
# TARGET_URL=https://example.com/chat

# ─── Web 目标认证凭据 (可选) ────────────────────────────────
# 供 YAML Profile 中的 auto_fill 通过 ${TARGET_USERNAME} 引用
# TARGET_USERNAME=your_username
# TARGET_PASSWORD=your_password

# ─── 攻击调优参数 ────────────────────────────────────────────
# 调优参数已迁移到 config/attack_params.yaml (进入 Git, 团队共享)
# 优先级: 命令行 --flag > config/attack_params.yaml > 硬编码兜底
# 修改方式: 编辑 config/attack_params.yaml 或使用命令行 --flag 覆盖
