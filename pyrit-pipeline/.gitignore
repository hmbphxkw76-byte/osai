# ============================================================================
# pyrit-pipeline .gitignore — 二次开发项目专属
# ============================================================================

# ── 密钥 (不入库) ──
# 上层 osai/.gitignore 已全局忽略 .env, 此处不再重复
.pyrit_cache/

# ── 虚拟环境 ──
.venv/
venv/
ENV/
env.bak/
venv.bak/

# ── 运行时输出 ──
# 上层 osai/.gitignore 全局忽略 outputs/
# 此处强制允许 outputs/empirical_asr/ (经验 ASR 数据, 便于环境迁移)
outputs/*
!outputs/empirical_asr/
/results/
dbdata/
eval/
default_memory.json.memory
artifacts/

# ── Python 缓存 ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
build/
dist/
.eggs/

# ── 测试 / 覆盖率 ──
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.mypy_cache/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# ── Jupyter ──
.ipynb_checkpoints

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo

# ── OS ──
**/.DS_Store
Thumbs.db

# ── PyRIT 数据库 (大二进制文件, 不入库) ──
*.sqlite
*.sqlite-journal
*.db

# ── 日志 ──
*.log

# 外部源码目录（不入库）
../src/
