# ============================================================================
# pyrit-pipeline .gitignore — 二次开发项目专属
# ============================================================================

# ── 密钥与配置 ──
# 私有仓库: .env 和 .pyrit_conf 可提交, 便于环境迁移
# 如转为公开仓库, 请重新忽略 .env
.pyrit_cache/

# ── 虚拟环境 ──
.venv/
venv/
ENV/
env.bak/
venv.bak/

# ── 运行时输出 ──
# 仅 outputs/empirical_asr/ 可提交 (经验 ASR 数据, 便于环境迁移)
# 其余 outputs/ 内容保持忽略
outputs/*
!outputs/empirical_asr/
/results/
dbdata/
eval/
default_memory.json.memory
artifacts/

# ── Python 缓存 ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
build/
dist/
.eggs/

# ── 测试 / 覆盖率 ──
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.mypy_cache/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# ── Jupyter ──
.ipynb_checkpoints

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo

# ── OS ──
**/.DS_Store
Thumbs.db

# ── PyRIT 数据库 (大二进制文件, 不入库) ──
*.sqlite
*.sqlite-journal
*.db

# ── 日志 ──
*.log

# 外部源码目录（不入库）
../src/
