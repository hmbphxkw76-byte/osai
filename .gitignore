# 忽略 src 目录下所有内容，不上传到 GitHub
/src/

# Python 字节码缓存
__pycache__/
*.py[cod]
*.pyo

# 测试缓存
.pytest_cache/
.tox/
.coverage
htmlcov/

# 虚拟环境
.venv/
venv/
env/

# IDE 配置
.vscode/
.idea/
*.swp
*.swo

# 环境变量 / 密钥
# pyrit-pipeline 为私有仓库, .env 可提交
# garak-pipeline / recon-pipeline 保持忽略
garak-pipeline/.env
recon-pipeline/.env
*.secret
*secret*.yaml

# 包构建产物
*.egg-info/
dist/
build/

# 运行时输出 (各子项目自行管理)
garak-pipeline/outputs/
recon-pipeline/outputs/
*.log

# 操作系统
.DS_Store
Thumbs.db
