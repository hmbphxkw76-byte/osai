# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage

# ============================================================
# 临时文件 — 所有以下模式的文件禁止提交
# ============================================================

# 临时调试/修复/验证脚本
_*.py

# 临时提取脚本 (AI 会话产生)
.temp_*.py

# 临时章节课件/数据提取文本
.temp_*.txt

# 临时课程大纲/考试资料
.temp_syllabus*.txt
.temp_exam*.txt

# 临时 pytest/验证输出
pytest_*.txt
validate_*.txt
validate_*.log
tmp_*.txt
tmp_*.log

# 运行产物
.redteam_runs/
results/
reports/
auth_store/

# 认证头文件（含 Cookie/Token）
config/headers/

# 自动下载的外部二进制（由 scripts/install_tools.py 重新生成）
tools/

# 密钥 / 本地配置
.env
*.local.yaml

# 编辑器
.vscode/
.idea/
