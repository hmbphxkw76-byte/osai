# ============================================================
# .gitignore - promptfoo 项目
# ============================================================

# 环境变量
.env
.env.local
.env.*.local

# promptfoo 缓存和输出
.promptfoo/
output/
results/
*.json
!datasets/*.json
!package.json

# 日志
*.log
logs/

# 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
dist/
*.egg-info/
*.egg

# 临时文件
tmp/
temp/
*.tmp
*.bak
*.backup

# 证书和密钥
*.pem
*.key
*.crt
*.p12
*.pfx

# 测试覆盖率
coverage/
.nyc_output/
