##############################################################################
#                    LLM 渗透测试多平台 API 配置文件
##############################################################################
# 📌 核心原则: 最小化代码修改
#    - 修改 .env 即可切换平台/模型
#    - YAML 中使用 {{ env.VAR_NAME }} 自动读取，无需改 YAML
#    - 测试仅需: 选平台 → 填 Key → 复制 YAML → 改 body 字段名 → 运行
##############################################################################

# ============================================================
# 第一步：选择平台（修改 PLATFORM_SELECTOR 的值即可切换）
# ============================================================
# 支持平台:
#   国内平台: ZHIPU, QWEN, BAIDU, DEEPSEEK
#   国外主流: OPENAI, ANTHROPIC, AZURE_OPENAI, AWS_BEDROCK, GOOGLE_GEMINI
#   开源本地: OLLAMA, HUGGINGFACE
#   欧洲平台: COHERE, MISTRAL, PERPLEXITY, VOYAGE
#   Meta平台: META_LLAMA
#   聚合网关: OPENROUTER, LITELLM (推荐！一键访问 300+ 模型)
# ============================================================
PLATFORM_SELECTOR=OLLAMA


##############################################################################
# ==================== 【公共变量】所有平台通用 ====================
##############################################################################
# YAML 中可通过 {{ env.VAR_NAME }} 引用这些变量
# 各平台区的变量可引用或覆盖这些公共变量

# 主目标 URL - 测试提供的被测端点
TARGET_URL=http://localhost:11434/v1/chat/completions

# API 认证 Token - 目标系统的认证凭证（如需则取消 YAML 中 Authorization 注释）
AUTH_TOKEN=your-bearer-token-here

# 第二目标端点（多目标对比测试，取消 YAML 中第二个 target 注释即可启用）
# TARGET_URL_2=https://staging-api.example.com/v1/chat

# 公共 API Key（各平台可引用此变量，或定义自己的平台专用 Key）
API_KEY=your-api-key-here

# 公共 API 基础地址
API_BASE_URL=https://api.example.com/v1

# 公共模型名称
MODEL_NAME=gpt-4o

# 代理地址（如需通过代理访问外部 API）
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080


##############################################################################
# ==================== 【聚合网关】OPENROUTER / LITELLM ====================
##############################################################################
# 推荐使用！一键访问 300+ 模型，无需多 Key 管理

# ------------------------------
# OpenRouter - 统一 API 网关
# 官网: https://openrouter.ai
# YAML provider: openrouter:provider/model
# 公共变量映射: API_KEY → OPENROUTER_API_KEY, MODEL_NAME → OPENROUTER_MODEL
# ------------------------------
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=openai/gpt-5.4
# 可选攻击模型 (YAML redteam.provider):
#   openrouter:openai/gpt-5.4
#   openrouter:anthropic/claude-opus-4.7
#   openrouter:google/gemini-2.5-pro
#   openrouter:deepseek/deepseek-v3.2
#   openrouter:qwen/qwen3-32b
#   openrouter:zhipuai/glm-4-flash

# ------------------------------
# LiteLLM - 统一多模型接口（自托管/代理模式）
# 官网: https://docs.litellm.ai
# YAML provider: litellm:provider/model
# 公共变量映射: API_KEY → LITELLM_API_KEY, API_BASE_URL → LITELLM_API_BASE, MODEL_NAME → LITELLM_MODEL
# ------------------------------
LITELLM_API_KEY=your-litellm-key-here
LITELLM_API_BASE=http://localhost:4000
LITELLM_MODEL=gpt-5.4
# 可选攻击模型 (YAML redteam.provider):
#   litellm:openai/gpt-5.4
#   litellm:anthropic/claude-opus-4.7
#   litellm:zhipu/glm-4-plus


##############################################################################
# ==================== 【国外主流平台】=======================================
##############################################################################

# ------------------------------
# OpenAI
# 官网: https://platform.openai.com
# YAML provider: openai:MODEL
# 公共变量映射: API_KEY → OPENAI_API_KEY, MODEL_NAME → OPENAI_MODEL
# ------------------------------
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5
# 可选攻击模型 (YAML redteam.provider):
#   openai:gpt-5
#   openai:gpt-5-mini
#   openai:o4-mini

# ------------------------------
# Anthropic Claude
# 官网: https://console.anthropic.com
# YAML provider: anthropic:messages:MODEL
# 公共变量映射: API_KEY → ANTHROPIC_API_KEY, MODEL_NAME → ANTHROPIC_MODEL
# ------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# 可选攻击模型 (YAML redteam.provider):
#   anthropic:messages:claude-opus-4-6
#   anthropic:messages:claude-sonnet-4-20250514
#   anthropic:messages:claude-haiku-4.5

# ------------------------------
# Azure OpenAI
# 官网: https://azure.microsoft.com/en-us/products/ai-services/openai-service
# YAML provider: azureopenai:DEPLOYMENT_NAME
# 公共变量映射: API_KEY → AZURE_OPENAI_API_KEY, API_BASE_URL → AZURE_OPENAI_ENDPOINT
# ------------------------------
AZURE_OPENAI_API_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o-deployment-name
# 可选攻击模型 (YAML redteam.provider):
#   azureopenai:gpt-4o-deployment-name

# ------------------------------
# AWS Bedrock
# 官网: https://aws.amazon.com/bedrock
# YAML provider: bedrock:MODEL_ID
# 认证: 需要 AWS IAM 凭证（环境变量或 ~/.aws/credentials）
# ------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-opus-4-6-v1:0
# 可选攻击模型 (YAML redteam.provider):
#   bedrock:us.anthropic.claude-opus-4-6-v1:0
#   bedrock:us.anthropic.claude-sonnet-4-20250514-v1:0
#   bedrock-agent:YOUR_AGENT_ID

# ------------------------------
# Google Gemini (Google AI Studio / Vertex AI)
# 官网: https://aistudio.google.com
# YAML provider: google:MODEL
# 公共变量映射: API_KEY → GOOGLE_API_KEY, MODEL_NAME → GOOGLE_MODEL
# ------------------------------
GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL=gemini-2.5-flash
# 可选攻击模型 (YAML redteam.provider):
#   google:gemini-2.5-pro
#   google:gemini-2.5-flash


##############################################################################
# ==================== 【国内平台】===========================================
##############################################################################

# ------------------------------
# DeepSeek (内置 provider)
# 官网: https://platform.deepseek.com
# YAML provider: deepseek:MODEL
# 公共变量映射: API_KEY → DEEPSEEK_API_KEY, MODEL_NAME → DEEPSEEK_MODEL
# ------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-flash
# 可选攻击模型 (YAML redteam.provider):
#   deepseek:deepseek-v4-flash    (非思考模式)
#   deepseek:deepseek-v4-pro      (高能力模式)
#   deepseek:deepseek-reasoner    (旧别名→v4-flash 思考模式，废弃于2026-07-24)

# ------------------------------
# 通义千问 Qwen / 阿里云百炼
# 官网: https://bailian.console.aliyun.com
# YAML provider: alibaba:MODEL
# 公共变量映射: API_KEY → ALIBABA_API_KEY, MODEL_NAME → ALIBABA_MODEL
# ------------------------------
ALIBABA_API_KEY=sk-your-alibaba-key
ALIBABA_MODEL=qwen-max
# 可选攻击模型 (YAML redteam.provider):
#   alibaba:qwen-max
#   alibaba:qwen-plus
#   alibaba:qwen-turbo

# ------------------------------
# 智谱 AI (Zhipu AI)
# 官网: https://open.bigmodel.cn
# YAML provider (HTTP): id: https://open.bigmodel.cn/api/paas/v4/chat/completions
# OpenRouter: openrouter:zhipuai/glm-4-flash
# 公共变量映射: API_KEY → ZHIPU_API_KEY, API_BASE_URL → ZHIPU_ENDPOINT, MODEL_NAME → ZHIPU_MODEL
# ------------------------------
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_ENDPOINT=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-plus
# 作为攻击模型 (YAML redteam.provider):
#   openrouter:zhipuai/glm-4-flash          (通过 OpenRouter)
# 作为测试目标 (YAML targets):
#   id: https
#   config:
#     url: '{{ env.ZHIPU_ENDPOINT }}/chat/completions'
#     headers:
#       Authorization: 'Bearer {{ env.ZHIPU_API_KEY }}'
#     body:
#       model: '{{ env.ZHIPU_MODEL }}'
#       message: '{{prompt}}'

# ------------------------------
# 百度文心一言 / 千帆平台
# 官网: https://qianfan.cloud.baidu.com
# 集成方式: OpenRouter 或 HTTP Provider (OpenAI 兼容)
# OpenRouter: openrouter:baidu/ernie-bot-turbo
# ------------------------------
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret-key
BAIDU_MODEL=ernie-bot-turbo
# 作为攻击模型 (YAML redteam.provider):
#   openrouter:baidu/ernie-bot-turbo       (通过 OpenRouter)


##############################################################################
# ==================== 【开源本地平台】=======================================
##############################################################################

# ------------------------------
# Ollama - 本地 LLM 运行环境
# 官网: https://ollama.com
# YAML provider: ollama:chat:MODEL
# 公共变量映射: API_BASE_URL → OLLAMA_BASE_URL, MODEL_NAME → OLLAMA_MODEL
# ------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3
# 可选攻击模型 (YAML redteam.provider):
#   ollama:chat:llama3.3
#   ollama:chat:qwen3
#   ollama:chat:deepseek-r1:8b
#   ollama:chat:phi4

# ------------------------------
# HuggingFace - 开源模型托管与推理
# 官网: https://huggingface.co
# YAML provider: huggingface:chat:MODEL
# 公共变量映射: API_KEY → HUGGINGFACE_API_KEY, MODEL_NAME → HUGGINGFACE_MODEL
# ------------------------------
HUGGINGFACE_API_KEY=hf-your-key-here
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct
# 可选攻击模型 (YAML redteam.provider):
#   huggingface:chat:meta-llama/Llama-3.3-70B-Instruct
#   huggingface:chat:Qwen/Qwen2.5-72B-Instruct


##############################################################################
# ==================== 【欧洲平台】===========================================
##############################################################################

# ------------------------------
# Mistral AI
# 官网: https://console.mistral.ai
# YAML provider: mistral:MODEL
# 公共变量映射: API_KEY → MISTRAL_API_KEY, MODEL_NAME → MISTRAL_MODEL
# ------------------------------
MISTRAL_API_KEY=your-mistral-key
MISTRAL_MODEL=magistral-medium-latest
# 可选攻击模型 (YAML redteam.provider):
#   mistral:magistral-medium-latest

# ------------------------------
# Cohere
# 官网: https://dashboard.cohere.com
# YAML provider: cohere:MODEL
# 公共变量映射: API_KEY → COHERE_API_KEY, MODEL_NAME → COHERE_MODEL
# ------------------------------
COHERE_API_KEY=your-cohere-key
COHERE_MODEL=command-a-03-2025
# 可选攻击模型 (YAML redteam.provider):
#   cohere:command-a-03-2025

# ------------------------------
# Perplexity AI
# 官网: https://www.perplexity.ai
# YAML provider: perplexity:MODEL
# 公共变量映射: API_KEY → PERPLEXITY_API_KEY, MODEL_NAME → PERPLEXITY_MODEL
# ------------------------------
PERPLEXITY_API_KEY=pplx-your-key-here
PERPLEXITY_MODEL=sonar-pro
# 可选攻击模型 (YAML redteam.provider):
#   perplexity:sonar-pro

# ------------------------------
# Voyage AI (嵌入模型)
# 官网: https://www.voyageai.com
# YAML provider: voyage:MODEL
# 公共变量映射: API_KEY → VOYAGE_API_KEY, MODEL_NAME → VOYAGE_MODEL
# ------------------------------
VOYAGE_API_KEY=your-voyage-key
VOYAGE_MODEL=voyage-3
# 可选攻击模型 (YAML redteam.provider):
#   voyage:voyage-3


##############################################################################
# ==================== 【Meta 平台】==========================================
##############################################################################

# ------------------------------
# Meta Llama API (官方 API)
# 官网: https://www.llama.com
# YAML provider: llamaapi:MODEL
# 公共变量映射: API_KEY → LLAMA_API_KEY, MODEL_NAME → LLAMA_MODEL
# ------------------------------
LLAMA_API_KEY=your-llama-api-key
LLAMA_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
# 可选攻击模型 (YAML redteam.provider):
#   llamaapi:Llama-4-Maverick-17B-128E-Instruct-FP8
#   llamaapi:Llama-4-Scout-17B-128E-Instruct-FP8


##############################################################################
# ==================== 变量引用与组合示例 ====================
##############################################################################
#
# 【场景 A】使用公共变量快速配置（推荐）
#
#   在 YAML 中直接引用公共变量，无需关心具体平台：
#   providers:
#     - id: 'openai:chat:{{ env.MODEL_NAME }}'
#       config:
#         apiKey: '{{ env.API_KEY }}'
#
# 【场景 B】使用平台专用变量
#
#   在 YAML 中引用特定平台的变量：
#   providers:
#     - id: 'google:{{ env.GOOGLE_MODEL }}'
#       config:
#         apiKey: '{{ env.GOOGLE_API_KEY }}'
#
# 【场景 C】混合引用（公共变量 + 平台变量）
#
#   targets:
#     - id: https
#       config:
#         url: '{{ env.ZHIPU_ENDPOINT }}/chat/completions'  # 平台专用
#         headers:
#           Authorization: 'Bearer {{ env.API_KEY }}'       # 公共变量
#         body:
#           model: '{{ env.MODEL_NAME }}'                   # 公共变量
#           message: '{{prompt}}'
#
# 【场景 D】多目标对比测试（使用公共变量切换）
#
#   修改 PLATFORM_SELECTOR 和对应的平台变量，无需修改 YAML：
#   PLATFORM_SELECTOR=GOOGLE_GEMINI
#   GOOGLE_API_KEY=your-key
#   GOOGLE_MODEL=gemini-2.5-pro
#
##############################################################################
