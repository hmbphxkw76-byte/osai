# ============================================================
# PyRIT .env_local — 个人覆盖配置
# ============================================================
# 本文件覆盖 .env 中的设置，用于个人覆盖团队共享配置。
# 对齐 PyRIT 1.0.0 Configuration 文档的 .env_local 概念。
#
# 例如，如果想要不同的目标，可以在此覆盖：
#   OPENAI_CHAT_ENDPOINT = ${AZURE_OPENAI_GPT4O_ENDPOINT2}
#   OPENAI_CHAT_MODEL = ${AZURE_OPENAI_GPT4O_MODEL2}
#
# 注意：.env_local 不会被 git 跟踪（已在 .gitignore 中）。
# ============================================================

# 覆盖目标模型
# TARGET_ENDPOINT=http://localhost:11434/v1
# TARGET_MODEL=qwen3:0.6b
# TARGET_API_KEY=ollama

# 覆盖评分器模型
# JUDGE_ENDPOINT=https://integrate.api.nvidia.com/v1
# JUDGE_MODEL=meta/llama-3.1-8b-instruct
# JUDGE_API_KEY=your-api-key

# 覆盖 Scenario 重试为生产模式
# SCENARIO_MAX_RETRIES=3
