# ============================================================
# PyRIT AI Red Team — 环境配置模板
# ============================================================
# 复制本文件为 .env，填入实际值后使用：
#   cp .env.example .env
#
# .env 包含密钥，已在 .gitignore 中排除，不会被提交
#
# 个人覆盖：创建 .env.local（同样 gitignored），覆盖 .env 中的值
#
# 配置优先级：.env.local > .env > config/defaults/*.yaml
# ============================================================

# ─── 目标模型 (被攻击的 LLM) ───────────────────────────────
# OpenAI 兼容端点 (Ollama/vLLM/LiteLLM/Azure OpenAI 等，需追加 /v1)
TARGET_ENDPOINT=http://localhost:11434/v1
# 模型名称 (Ollama: `ollama list` 查看可用模型)
TARGET_MODEL=qwen3:0.6b
# API Key (Ollama 无需认证，填任意占位值；Azure OpenAI 使用真实 Key)
TARGET_API_KEY=your-api-key-here

# ─── 评分器模型 (Judge LLM) ────────────────────────────────
# 评分器端点 (OpenAI 兼容)
JUDGE_ENDPOINT=https://api.openai.com/v1
# 评分器模型名称
JUDGE_MODEL=gpt-4o
# 评分器 API Key
JUDGE_API_KEY=your-judge-api-key-here

# ─── Adversarial Chat 模型 (多轮攻击的攻击方) ───────────────
# RedTeamingAttack/CrescendoAttack 等多轮攻击需要 adversarial_chat 生成攻击 prompt
# 默认复用 JUDGE_* 配置（轻量级模型，快速生成攻击 prompt）
# 如需单独配置，取消注释以下变量：
# ADVERSARIAL_ENDPOINT=https://api.openai.com/v1
# ADVERSARIAL_MODEL=gpt-4o-mini
# ADVERSARIAL_API_KEY=your-adversarial-api-key-here

# ─── HTTP 超时配置 ───────────────────────────────────────
# 覆盖 config/defaults/http_client.yaml 中的 target.timeout
# 大模型推理队列拥堵时单次响应可能 200s+，默认 300s
TARGET_HTTPX_TIMEOUT=300

# ─── Converter 模型 (LLM 辅助 Converter，默认复用目标模型) ──
# PersuasionConverter / DecompositionConverter 等 LLM 辅助 Converter 需要模型生成攻击内容
# 安全对齐模型（如 Llama-3.1）会拒绝生成 → 500 错误
# 默认复用 TARGET_* 配置（被测试的模型通常限制较少）
# 如需单独配置，取消注释以下变量：
# CONVERTER_ENDPOINT=https://api.openai.com/v1
# CONVERTER_MODEL=gpt-4o
# CONVERTER_API_KEY=your-converter-api-key-here
# CONVERTER_MAX_RPM=

# ============================================================
# 以上为 .env 必须填写的参数。以下参数已迁移至 config/defaults/ 目录。
#
# 如需临时覆盖（单次运行），在 .env 中设置对应环境变量即可（优先级最高）。
# 如需持久修改，编辑对应 YAML 文件:
#
#   config/defaults/pipeline.yaml:
#     strategy_mode          策略模式 (academic/exam/balanced)
#     scenario_max_retries   弹性恢复重试次数
#     owasp_success_threshold  L2 OWASP 成功率阈值
#     max_attempts_per_objective  每载荷最大尝试次数
#     adaptive_max_concurrency   Adaptive 并发数
#     api_max_concurrency    API 级并发信号量
#     per_attack_timeout     单次攻击超时
#     timeout_overrides      差异化超时 (single_turn/multi_turn/sequential)
#     retry.max_num_attempts  低层 HTTP 重试次数
#     retry.wait_min/max_seconds  低层重试等待
#
#   config/defaults/model_params.yaml:
#     target.temperature     目标温度 (0.9=ASR最大化, 0=可复现)
#     target.top_p           核采样
#     target.max_completion_tokens  最大 token
#     judge.temperature      评分器温度 (0=确定性)
#
#   config/defaults/http_client.yaml:
#     target.timeout         HTTP 读取超时 (秒)
#     target.verify          SSL 证书验证
#     target.http2           HTTP/2 支持
#
# 详细配置说明: config/defaults/README.md
# ============================================================
