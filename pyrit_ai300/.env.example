# ============================================================
# PyRIT Pipeline - 环境配置模板
# ============================================================
# 复制本文件为 .env，填入实际值后使用：
#   cp .env.example .env
#
# .env 包含密钥，已在 .gitignore 中排除，不会被提交
#
# 配置优先级：.env > config/defaults/*.yaml > config/targets/*.yaml > config/runtime.yaml
# ============================================================

# ─── 目标模型 (被攻击的 LLM) ───────────────────────────────
# OpenAI 兼容端点 (Ollama/vLLM/LiteLLM/Azure OpenAI 等，需追加 /v1)
TARGET_ENDPOINT=http://localhost:11434/v1
# 模型名称 (在目标上运行 `ollama list` 查看可用模型)
TARGET_MODEL=qwen3:0.6b
# API Key (Ollama 不需要认证，使用任意占位值；Azure OpenAI 使用真实 Key)
TARGET_API_KEY=your-api-key-here

# ─── 评分器模型 (Judge LLM) ────────────────────────────────
# 评分器端点 (OpenAI 兼容)
JUDGE_ENDPOINT=https://api.openai.com/v1
# 评分器模型名称
JUDGE_MODEL=gpt-4o
# 评分器 API Key
JUDGE_API_KEY=your-judge-api-key-here

# ─── 可选覆盖（以下参数均有合理默认值，按需修改）──────────

# 目标类型手动覆盖 (留空 = 自动检测)
# TARGET_TYPE=openai_chat

# 认证模式 (auto / api_key / identity)
# TARGET_AUTH_MODE=auto

# 最大并发数 (默认 1，串行避免触发限流)
# MAX_CONCURRENCY=1

# 交互式种子选择 (true=终端交互, false=全选跳过)
# INTERACTIVE_SELECTION=true

# ─── 高级覆盖（通常不需要修改，详见 config/defaults/）──────
# 模型参数:     config/defaults/model_params.yaml
# Pipeline:     config/defaults/pipeline.yaml
# HTTP 客户端:  config/defaults/http_client.yaml
# 路径:         config/defaults/paths.yaml
