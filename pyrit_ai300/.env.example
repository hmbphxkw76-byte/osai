# ============================================================
# PyRIT AI Red Team — 环境配置模板
# ============================================================
# 复制本文件为 .env，填入实际值后使用：
#   cp .env.example .env
#
# .env 包含密钥，已在 .gitignore 中排除，不会被提交
#
# 个人覆盖：创建 .env.local（同样 gitignored），覆盖 .env 中的值
#
# 配置优先级：.env.local > .env > config/defaults/*.yaml
# ============================================================

# ─── 目标模型 (被攻击的 LLM) ───────────────────────────────
# OpenAI 兼容端点 (Ollama/vLLM/LiteLLM/Azure OpenAI 等，需追加 /v1)
TARGET_ENDPOINT=http://localhost:11434/v1
# 模型名称 (Ollama: `ollama list` 查看可用模型)
TARGET_MODEL=qwen3:0.6b
# API Key (Ollama 无需认证，填任意占位值；Azure OpenAI 使用真实 Key)
TARGET_API_KEY=your-api-key-here

# ─── 评分器模型 (Judge LLM) ────────────────────────────────
# 评分器端点 (OpenAI 兼容)
JUDGE_ENDPOINT=https://api.openai.com/v1
# 评分器模型名称
JUDGE_MODEL=gpt-4o
# 评分器 API Key
JUDGE_API_KEY=your-judge-api-key-here

# ─── Converter 模型 (LLM 辅助 Converter，默认复用目标模型) ──
# PersuasionConverter / DecompositionConverter 等 LLM 辅助 Converter 需要模型生成攻击内容
# 安全对齐模型（如 Llama-3.1）会拒绝生成 → 500 错误
# 默认复用 TARGET_* 配置（被测试的模型通常限制较少）
# 如需单独配置，取消注释以下变量：
# CONVERTER_ENDPOINT=https://api.openai.com/v1
# CONVERTER_MODEL=gpt-4o
# CONVERTER_API_KEY=your-converter-api-key-here
# CONVERTER_MAX_RPM=

# ─── 弹性恢复 ──────────────────────────────────────────────
# Scenario 重试次数 (0=快速失败/开发, 2=考试推荐, 3=生产推荐)
SCENARIO_MAX_RETRIES=2

# ─── 以下参数均有合理默认值，按需取消注释 ──────────────────

# 目标类型手动覆盖 (留空 = 自动检测: GET /v1/models → /v1/responses)
# TARGET_TYPE=openai_chat

# 认证模式 (auto / api_key / identity) — identity 用于 Azure Entra ID
# TARGET_AUTH_MODE=auto

# ASR 引导策略模式 (academic=策略优先 / exam=编码优先 / balanced=均衡)
# STRATEGY_MODE=academic

# ─── 并发与限速 ────────────────────────────────────────────
# 最大并发攻击计划数 (1=串行避免限流)
# MAX_CONCURRENCY=1
# API 层并发信号量 (控制单次攻击内的并发 API 调用)
# API_MAX_CONCURRENCY=10
# Adaptive Scenario 并发度
# ADAPTIVE_MAX_CONCURRENCY=4
# 目标 RPM 限速 (激活 PyRIT 原生 @limit_requests_per_minute)
# TARGET_MAX_RPM=
# 评分器 RPM 限速
# JUDGE_MAX_RPM=

# ─── HTTP 重试 ─────────────────────────────────────────────
# 低层 HTTP 重试次数 (503/429 自动重试)
# RETRY_MAX_NUM_ATTEMPTS=3
# RETRY_WAIT_MIN_SECONDS=5
# RETRY_WAIT_MAX_SECONDS=220

# ─── 停止策略 ──────────────────────────────────────────────
# L2: 同一 OWASP 分类内成功率达标即跳过剩余 (0.0-1.0)
# OWASP_SUCCESS_THRESHOLD=0.5
# L3: 全局首成功即停 (true/false)
# STOP_ON_FIRST_SUCCESS=false

# ─── 交互式选择 ────────────────────────────────────────────
# 交互式种子选择 (true=终端交互, false=全选跳过, CI/CD 友好)
# INTERACTIVE_SELECTION=false

# ─── 三层渐进式选择 ────────────────────────────────────────
# TIERED_SELECTION_ENABLED=true
# TIERED_SELECTION_TARGET=
# TIERED_FALLBACK_STRATEGY=sequential_asr_desc

# ─── 高级覆盖（详见 config/defaults/）──────────────────────
# 模型推理参数: temperature/top_p/max_tokens/seed 等
# TARGET_TEMPERATURE=
# TARGET_TOP_P=
# TARGET_SEED=
# TARGET_REASONING_EFFORT=
#
# HTTP 客户端: 超时/SSL/代理
# TARGET_HTTPX_TIMEOUT=
# TARGET_HTTPX_VERIFY=
# TARGET_HTTPX_PROXY=
#
# 详细配置:     config/defaults/README.md
