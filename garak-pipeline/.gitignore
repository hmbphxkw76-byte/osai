# 运行产物（统一组织到 outputs/）
outputs/

# 外部源码目录（不入库）
../src/

# 预下载数据集（远程资产，本地存放、周期性更新，不入库）
data/

# 认证会话 Cookie（含敏感凭据，禁止入库）
sessions/

# 环境变量文件（含敏感凭据，禁止入库）
.env
.env.local

# 根目录临时日志（迁移到 outputs/logs/）
_tmp_*.log

# garak 原生报告目录（若未走本仓库产物目录时兜底忽略）
garak_runs/

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# IDE
.idea/
.vscode/
.trae/

# OS
Thumbs.db
.DS_Store
