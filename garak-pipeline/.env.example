# ============================================================
# garak-pipeline 环境变量模板
# 路径: .env.example
# ============================================================
# 复制本文件为 .env 并填写实际值：
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会入库。
# 优先级：命令行 / yaml 显式值 > .env > 空
# ============================================================

# --- OpenAI 兼容目标必填参数 ---
OPENAI_TARGET_ENDPOINT=https://api.longcat.chat/openai/v1
OPENAI_TARGET_MODEL=LongCat-2.0
OPENAICompatible_API_KEY=

# --- Web 认证目标必填参数 ---
WEB_TARGET_URL=
TARGET_USERNAME=
TARGET_PASSWORD=
