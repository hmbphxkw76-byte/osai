<script type="text/javascript">
    var BaseUrl = "/Account/";
    var element = document.getElementById("otherLogin");
    console.dir(navigator.userAgent);
    console.dir(/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent));
    if (element && window.location.href.includes('qwbx') 
    || navigator.userAgent.indexOf('allInOne_iOS_app') > -1 
    || navigator.userAgent.search('allInOne_iOS_app') > -1 
    || navigator.userAgent.indexOf('allInOne_android_app') > -1 
    || navigator.userAgent.search('allInOne_android_app') > -1
    || /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)) {
        element.style.display = "none";
    } else {
        element.style.display = "block";
    }
    var app = new Vue({
        el: "#app",
        data: function () {
            return {
                TabIndex: 1,
                Count: 0,
                Message: "发送验证码",
                PhoneTipsIsShow: false,
                CodeTipsIsShow: false,
                PasswordTipsIsShow: false,
                UserNameTipsIsShow: false,
                FormData: {
                    Mobile: "",
                    Code: "",
                    ReturnUrl: "",
                    RememberLogin: false,
                    ClientId: ""
                },
                FormLogin: {
                    UserName: "",
                    Password: "",
                    RememberLogin: false,
                    ReturnUrl: "",
                    // ClientId: "",
                    LotNumber: "",
                    CaptchaOutput: "",
                    PassToken: "",
                    GenTime: ""
                },
                 showPassword: false,
            };
        },
        // 计算属性
        computed: {
            // 是否是校友网you
            isAlumniNetwork() {
                return ['AlumniNetwork','AlumniNetworkManage'].indexOf(this.FormData.ClientId) !== -1;
            },
            // 是否是实验学院兼职网登录
            isOfficialWebsite() {
                return ['OfficialWebsite'].indexOf(this.FormData.ClientId) !== -1;
            }
        },
        created: function () {},
        mounted: function () {
            // 调整到 - mounted 钩子 进行获取路径 确保路径完整性
            this.GetUrl();
        },
        methods: {
              togglePassword() {
            this.showPassword = !this.showPassword;
        },
            GetUrl: function () {
                let str = location.href, num = str.indexOf("?");
                str = str.substr(num + 1);
                str = decodeURIComponent(str);
                let arr = str.substr(10);
                this.FormData.ReturnUrl = arr;
                this.FormLogin.ReturnUrl = arr;
                var client_id = this.getUrlParams("client_id");
                console.log(client_id,"client_id 重新写的正则");
                this.FormData.ClientId = client_id;
                this.FormLogin.ClientId = client_id;
                if (this.FormData.ClientId == "AllInOneCourseOpen") {
                    this.ChangeTab(2);
                    $(".loginTypeItems:eq(0)").hide();
                }
                else {
                    this.ChangeTab(1);
                }
            },
            getUrlParams(name) {
                var reg2 = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i"); //定义正则表达式
                var reg = new RegExp("(\\?|&)" + name + "=([^&]*)(&|$)", "i");
                var r = this.FormData.ReturnUrl.match(reg);
                var r2 = this.FormData.ReturnUrl.match(reg2);
                console.log(r2 ? r2[2] : null,"测试原正则是否有用");
                if (r != null) return unescape(r[2]);
                return null;
            },
            OnRememberLogin: function () {
                this.FormLogin.RememberLogin = this.FormData.RememberLogin;
            },
            SendMobileLoginCode: function () {
                var This = this;
                if (!this.CheckMobile()) {
                    this.PhoneTipsIsShow = true;
                    return;
                } else {
                    this.PhoneTipsIsShow = false;
                }
                jQuery.ajax({
                    'type': 'POST', 'url': BaseUrl + "SendLoginCode", 'contentType': 'application/json', 'data': JSON.stringify(this.FormData), 'dataType': 'json',
                    'success': function (data) {
                        if (data.State) {
                            This.CountDown();
                        } else {
                            alert(data.Message);
                        }
                    },
                    error: function () {
                        alert("验证码发送失败");
                    }
                });
            },

            submitfrom:function(){
                 
            },
            handlerCode: function () {

                if (!this.CheckUserName())
                {
                    this.PhoneTipsIsShow = true;
                    return;
                }else{
                    this.PhoneTipsIsShow = false;
                }

                if (!this.CheckPassword()) {
                    this.PasswordTipsIsShow = true;
                    return;
                }
                else {
                    this.PasswordTipsIsShow = false;
                }

                var This = this;
                initGeetest4({
                    // '18b55838db37e10b907db4f757a85ea7'
                    captchaId: '5c4c44c593d2e8e49773d6116ebdd375',
                    product: 'bind',
                    riskType: 'word',
                    new_captcha: true,
                    hide: true
                }, function (captcha) {

                    captcha.onReady(function () {
                        captcha.showCaptcha(); //显示验证码
                    });

                    captcha.onSuccess(function () {
                        let str = location.href, num = str.indexOf("?");
