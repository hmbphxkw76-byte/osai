            onSubmit: function (e) {
                var This = this;
                if (!This.CheckMobile()) {
                    This.PhoneTipsIsShow = true;
                    return;
                } else {
                    This.PhoneTipsIsShow = false;
                }
                if (!This.CheckCode()) {
                    This.CodeTipsIsShow = true;
                    return;
                } else {
                    This.CodeTipsIsShow = false;
                };
                jQuery.ajax({
                    'type': 'POST', 'url': BaseUrl + "Login", 'Content-Type': 'application/json', 'data': JSON.stringify(This.FormData), 'dataType': 'json',
                    'success': function (data) {
                        if (data.State) {
                            //window.location.href = data.Data;
                            //window.location.assign(data.Data);
                            console.log('返回的地址：' + data.Data);
                            window.open(data.Data, "_blank");

                        } else {
                            alert(data.Message);
                        }
                    },
                    error: function () {
                        alert("登录失败");
                    }
                });
            },
            onMobileSubmit: function (e) {
                var This = this;
                if (!this.CheckMobile()) {
                    this.PhoneTipsIsShow = true;
                    return;
                } else {
                    this.PhoneTipsIsShow = false;
                }
                if (!this.CheckCode()) {
                    this.CodeTipsIsShow = true;
                    return;
                } else {
                    this.CodeTipsIsShow = false;
                };
                jQuery.ajax({
                    'type': 'POST', 'url': BaseUrl + "MobileLogin", 'contentType': 'application/json', 'data': JSON.stringify(this.FormData), 'dataType': 'json',
                    'success': function (data) {
                        if (data.State) {
                            window.location.href = data.Data;
                        } else {
                            alert(data.Message);
                        }
                    },
                    error: function () {
                        alert("登录失败");
                    }
                });
            },
            CountDown: function () {
                if (this.Count > 0) return;
                this.Count = 60;
                this.Message = this.Count + "秒后重新发送"
                let clock = window.setInterval(() => {
                    if (this.Count <= 0) {
                        window.clearInterval(clock)
                        this.Message = '发送验证码'
                        return;
                    }
                    this.Count--
                    this.Message = this.Count + '秒后重新发送'
                }, 1000);
            },
            ChangeTab(index) {
                this.TabIndex = index
            },
            Forget() {
                window.location = "/Account/FindPassword"
            },
            OnBlurMobile() {
                if (this.CheckMobile()) {
                    this.PhoneTipsIsShow = false;
                } else {
                    this.PhoneTipsIsShow = true;
                }
            },
            OnBlurCode() {
                if (this.CheckCode()) {
                    this.CodeTipsIsShow = false;
                } else {
                    this.CodeTipsIsShow = true;
                }
            },
            OnBlurUserName() {
                if (this.CheckUserName()) {
                    this.UserNameTipsIsShow = false;
                } else {
                    this.UserNameTipsIsShow = true;
                }
            },
            OnBlurPassword() {
                if (this.CheckPassword()) {
                    this.PasswordTipsIsShow = false;
                } else {
                    this.PasswordTipsIsShow = true;
                }
            },
            CheckMobile() {
                let reg = /^[1][2,3,4,5,6,7,8,9][0-9]{9}$/;
                let Mobile = this.FormData.Mobile;
                if (!reg.test(Mobile)) {
                    return false;
                }
                return true;
            },
            CheckCode() {
                let reg = /^\d{6}$/gi;
                let Code = this.FormData.Code;
                if (!reg.test(Code)) {
                    return false;
                }
                return true;
            },
            IsNativeApp(){
                // 判断是不是手机端嵌套
                if (navigator.userAgent.indexOf('allInOne_iOS_app') > -1 || navigator.userAgent.search('allInOne_iOS_app') > -1 || navigator.userAgent.indexOf('allInOne_android_app') > -1 || navigator.userAgent.search('allInOne_android_app') > -1) {
                    return true;
                }
                return false;
            },
            CheckPassword: function () {
                let Password = this.FormLogin.Password;
                if (Password.length < 6) {
                    return false;
                }
                if (Password.length > 16) {
                    return false;
                }
                return true;
            },
            CheckUserName: function () {
                let UserName = this.FormLogin.UserName;
                if (UserName.length < 1) {
                    return false;
                }
                if (UserName.length > 50) {
                    return false;
                }
                return true;
            }
        }
    });
