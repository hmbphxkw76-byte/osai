# 一体化集成部署环境变量
# 复制本文件为 .env.integration 后填写实际值
# docker compose -f docker-compose.integration.yml --env-file .env.integration up -d
#
# 注意：
# - ai300-recon 主项目仍使用根目录 .env，仅保留 RECON_TARGET_URL。
# - 本文件用于 Redis / MinIO / AI-Infra-Guard / RedAmon / SkillSpector 等外部服务。

# ------------------------------------------------------------------
# Shared Layer
# ------------------------------------------------------------------
# MinIO 对象存储（如不使用 MinIO 可注释）
MINIO_ROOT_USER=pyritadmin
MINIO_ROOT_PASSWORD=change_me_in_production

# ------------------------------------------------------------------
# AI-Infra-Guard
# ------------------------------------------------------------------
# AIG 官方镜像已内置配置，通常无需额外变量。
# 如需自定义数据库路径或上传目录，可取消注释：
# AIG_DB_PATH=/app/db/tasks.db
# AIG_UPLOAD_DIR=/app/uploads

# ------------------------------------------------------------------
# RedAmon（至少配置一个 LLM provider key）
# ------------------------------------------------------------------
# Anthropic Claude（RedAmon 推荐）
ANTHROPIC_API_KEY=sk-ant-xxx

# 或 OpenAI
OPENAI_API_KEY=sk-xxx

# 如需本地 Ollama，取消注释并配置 RedAmon 官方文档中的 OLLAMA_URL
# OLLAMA_URL=http://host.docker.internal:11434

# ------------------------------------------------------------------
# SkillSpector（子进程或 Docker 模式均会读取）
# ------------------------------------------------------------------
# 默认使用 --no-llm 静态扫描，可不填；如需 LLM 分析请配置 provider。
SKILLSPECTOR_PROVIDER=openai
# OPENAI_API_KEY=sk-xxx  # 与 RedAmon 共用即可
