# ai300-attack 环境变量配置
# 复制本文件为 .env 后按需填写

# 侦察结果路径（相对于 ai300-attack/ 目录）
ATTACK_PROFILE=../ai300-recon/results/recon/profiles/example.json
ATTACK_PYRIT_TARGET=../ai300-recon/results/recon/pyrit/example_pyrit_target.json

# 攻击适配器：garak / pyrit / all（逗号分隔）
ATTACK_ADAPTERS=garak

# 输出目录
ATTACK_OUTPUT_DIR=results/attacks

# 单次攻击超时秒数
ATTACK_TIMEOUT=300

# 仅预览策略，不执行攻击
ATTACK_DRY_RUN=false

# Garak 额外命令行参数（可选，空格分隔）
# ATTACK_GARAK_PROBES=dan,promptinject
