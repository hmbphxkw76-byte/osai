# recon-pipeline 环境变量示例
# ─────────────────────────────────────────────
# 复制为 .env 并填入目标 URL 即可启动端到端侦察。
# 其余参数 (TARGET_TYPE / AUTH_TYPE / OUTPUT_DIR /
# EXPORT_FORMATS / ORG_DOMAINS / ALLOWED_HOSTS /
# DISALLOW_PATTERNS) 已在 config/settings.py 的
# RuntimeDefaults 中预置最优默认值, 无需在此填写。
# 如需覆盖, 在下方添加对应变量即可。

# ── 必填: 目标 URL (端到端侦察入口) ──
TARGET_URL=https://example.test

# ── 可选: API Key (模型平台 / Bearer 认证) ──
# 对 OpenAI / Ollama / vLLM 等模型平台目标, 填入 API Key
# 可启用已认证探测; 留空则匿名探测。
# API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── 可选: 手动覆盖默认值 (以下变量未设置时使用 config/settings.py 默认值) ──
# TARGET_TYPE=auto
# AUTH_TYPE=auto
# ORG_DOMAINS=example.test
# ALLOWED_HOSTS=example.test
# DISALLOW_PATTERNS=
# OUTPUT_DIR=outputs/reports
# EXPORT_FORMATS=json,pyrit,garak
