# recon-pipeline 必改环境变量示例
# 复制为 .env 并填入实际值。所有变量均通过 core.config 从环境变量加载。

# ── 必填: 目标 URL (端到端侦察入口) ──
TARGET_URL=https://example.test

# ── 目标平台类型 (可选, 留空则自动分类) ──
# 可选值:
#   auto          - 自动判断 (推荐)
#   llm_webapp    - 基于 LLM 的 Web 应用 (可能需要认证)
#   model_platform- OpenAI/Ollama/LM Studio/vLLM 等自建模型平台
TARGET_TYPE=auto

# ── 认证相关 (llm_webapp 目标可能需要) ──
# 认证类型: none / same_domain / cross_domain / otp / sliding / sms / qr / auto
AUTH_TYPE=auto
# 同域登录页 URL (same_domain 时必填)
AUTH_LOGIN_URL=
# 跨域 IdP URL (cross_domain 时必填)
AUTH_IDP_URL=
# 登录用户名/密码 (自动填充用, 不建议明文, 可用密钥管理)
AUTH_USERNAME=
AUTH_PASSWORD=
# API Key (模型平台 / Bearer 认证)
API_KEY=

# ── 组织边界 (Guardrail) ──
# 允许的侦察域名 (逗号分隔)
ORG_DOMAINS=example.test,example.com
# 允许的额外主机 (逗号分隔)
ALLOWED_HOSTS=example.test
# 禁止模式 (命中即拒绝, 逗号分隔)
DISALLOW_PATTERNS=evil,malicious

# ── 导出 ──
# 报告输出目录
OUTPUT_DIR=outputs/reports
# 导出格式 (逗号分隔): json,pyrit,garak
EXPORT_FORMATS=json,pyrit,garak
